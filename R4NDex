local function refreshEntry(e)
	local ok, v = pcall(e.get)
	if not ok then return end
	local box = e.box
	if e.kind == "boolean" then
		box.Text = tostring(v)
		box.TextColor3 = v and C.good or C.bad
	elseif e.kind == "Instance" then
		box.Text = typeof(v) == "Instance" and v:GetFullName() or "nil"
	else
		if box:IsA("TextBox") and box:IsFocused() then return end
		box.Text = fmt(v)
	end
	if e.swatch then
		local col = typeof(v) == "BrickColor" and v.Color or v
		if typeof(col) == "Color3" then e.swatch.BackgroundColor3 = col end
	end
end

local function addProp(name, get, set, readonly)
	local ok, v = pcall(get)
	if not ok then return false end
	local kind = typeof(v)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = C.panel, BorderSizePixel = 0, LayoutOrder = nextOrder() }, propScroll)
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = C.line, BorderSizePixel = 0 }, row)
	new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(0.45, 0, 0, 0), BackgroundColor3 = C.line, BorderSizePixel = 0 }, row)
	text(row, name, { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.45, -10, 1, -1), TextColor3 = Color3.fromRGB(215, 215, 215), TextTruncate = Enum.TextTruncate.AtEnd })
	local e = { get = get, kind = kind, name = name, row = row }
	local hasSwatch = (kind == "Color3" or kind == "BrickColor")
	local boxW = hasSwatch and UDim2.new(0.55, -22, 1, -1) or UDim2.new(0.55, -1, 1, -1)
	local base = {
		Position = UDim2.new(0.45, 1, 0, 0), Size = boxW, BackgroundTransparency = 1, TextColor3 = C.text, Font = FONT, TextSize = 14,
		BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}
	local box
	if kind == "boolean" and not readonly then
		base.AutoButtonColor = false
		box = new("TextButton", base, row)
		box.Activated:Connect(function()
			local ok2, cur = pcall(get)
			if ok2 then set(not cur) refreshEntry(e) end
		end)
	elseif kind == "Instance" then
		base.AutoButtonColor = false
		base.TextColor3 = C.accent2
		box = new("TextButton", base, row)
