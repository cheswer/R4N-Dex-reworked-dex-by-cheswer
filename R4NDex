-- coincidencias -------------------------------------------------------------------------------------
local function makeMatcher(q, case, pat)
	if pat then
		local p = case and q or X.ciPattern(q)
		local ok, e = pcall(string.find, "", p)
		if not ok then return nil, e end
		return {
			quick = function(src) local ok2, a = pcall(string.find, src, p) return ok2 and a ~= nil end,
			find = function(s) local ok2, a, b = pcall(string.find, s, p) if ok2 then return a, b end end,
		}
	end
	if case then
		return { quick = function(src) return src:find(q, 1, true) ~= nil end, find = function(s) return s:find(q, 1, true) end }
	end
	local lq = q:lower()
	return {
		quick = function(src) return src:lower():find(lq, 1, true) ~= nil end,
		find = function(s) return s:lower():find(lq, 1, true) end,
	}
end

local function clean(s) return (s:gsub("[%c]", " ")) end
local function hlSnippet(line, s, e)
	line = clean(line)
	local a = math.max(1, s - 40)
	local b = math.min(#line, e + 90)
	local pre, mid, post = line:sub(a, s - 1), line:sub(s, e), line:sub(e + 1, b)
	return (a > 1 and "…" or "") .. X.escRT(pre) .. '<font color="#ffc600"><b>' .. X.escRT(mid) .. "</b></font>" .. X.escRT(post)
end
local function pathOf(inst)
	local ok, p = pcall(function() return inst.Parent and inst.Parent:GetFullName() or "nil" end)
	return ok and p or "?"
end
local function titleFor(inst, extra)
	return X.escRT(inst.Name) .. '  <font color="#7a7a7a">' .. X.escRT(pathOf(inst)) .. "</font>" .. (extra or "")
end

local function scriptConstants(inst)
	local c = X.constCache[inst]
	if c then return c end
	local list, uniq = {}, {}
	local getc = getscriptclosure or getscriptfunction
	if getc and debug and debug.getconstants then
		local ok, f = pcall(getc, inst)
		if ok and type(f) == "function" then
			local seen, n = {}, 0
			local function walk(fn, d)
				if d > 6 or seen[fn] or n > 5000 then return end
				seen[fn] = true
				local okc, cs = pcall(debug.getconstants, fn)
				if okc and type(cs) == "table" then
					for _, v in pairs(cs) do
						if type(v) == "string" and #v > 0 and #v < 400 and not uniq[v] then
							uniq[v] = true
							n += 1
							list[#list + 1] = v
						end
					end
				end
				if debug.getprotos then
					local okp, ps = pcall(debug.getprotos, fn)
					if okp and type(ps) == "table" then
						for _, p in ipairs(ps) do
							if type(p) == "function" then walk(p, d + 1) end
						end
					end
				end
			end
			walk(f, 0)
		end
	end
	X.constCache[inst] = list
	return list
end

