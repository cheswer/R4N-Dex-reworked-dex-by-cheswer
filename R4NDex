	local added = addProp(pn, function() return getProp(inst, pn) end, function(v) setProp(inst, pn, v) end)
	notify(added and ("Añadida: " .. pn) or ("No existe / inaccesible: " .. pn), added and "good" or "bad")
	customBox.Text = ""
	applyVisibility()
end)

