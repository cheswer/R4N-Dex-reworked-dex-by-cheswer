-- rutas de archivo / guardado ---------------------------------------------------------
local function safeName(s) return (tostring(s):gsub('[<>:"/\\|%?%*%c]', "_")) end
local function ensureDir(path)
	if not (makefolder and isfolder) then return end
	local cur = ""
	for seg in path:gmatch("[^/]+") do
		cur = cur == "" and seg or (cur .. "/" .. seg)
		if not isfolder(cur) then pcall(makefolder, cur) end
	end
end
local function scriptFile(inst, base)
	local chain, p, d = {}, inst, 0
	while p and p ~= game and d < 60 do
		table.insert(chain, 1, safeName(p.Name))
		p, d = p.Parent, d + 1
	end
	if p ~= game then table.insert(chain, 1, "_nil") end
	local file = table.remove(chain) or "script"
	return base .. (#chain > 0 and ("/" .. table.concat(chain, "/")) or ""), file
end
local function header(inst, method)
	return ("-- R4N Explorer · %s\n-- %s · método: %s\n\n"):format(getPath(inst), inst.ClassName, tostring(method))
end

X.saveScript = function(inst)
	if not writefile then notify("Tu executor no tiene writefile", "bad") return end
	if not inst or not inst:IsA("LuaSourceContainer") then notify("Selecciona un script", "warn") return end
	task.spawn(function()
		local src, method = fetchSource(inst)
		if not src then notify("No se pudo obtener el código para guardar", "bad") return end
		local dir, file = scriptFile(inst, "R4NExplorer/Dump_" .. tostring(game.PlaceId))
		ensureDir(dir)
		local path = dir .. "/" .. file .. ".lua"
		local ok = pcall(writefile, path, header(inst, method) .. src)
		notify(ok and ("Guardado: " .. path) or "Error al guardar", ok and "good" or "bad")
	end)
end

local dumpAllBusy = false
X.dumpAll = function(rootInst)
	if not writefile then notify("Tu executor no tiene writefile", "bad") return end
	if dumpAllBusy then notify("Ya hay un volcado en curso", "warn") return end
	dumpAllBusy = true
	task.spawn(function()
		local list = {}
		for _, s in ipairs(X.collectScripts(true)) do
			if not X.skip(s) and (not rootInst or s == rootInst or s:IsDescendantOf(rootInst)) then list[#list + 1] = s end
		end
		local base = "R4NExplorer/Dump_" .. tostring(game.PlaceId)
		local used, ok, fail = {}, 0, 0
		for i, s in ipairs(list) do
			if not alive then break end
			if i % 5 == 0 then notify(("Volcando scripts %d/%d …"):format(i, #list), "warn") end
			local src, method = fetchSource(s)
			if src then
				local dir, file = scriptFile(s, base)
				local path = dir .. "/" .. file
				used[path] = (used[path] or 0) + 1
				if used[path] > 1 then path = path .. "_" .. used[path] end
				ensureDir(dir)
				if pcall(writefile, path .. ".lua", header(s, method) .. src) then ok += 1 else fail += 1 end
			else
				fail += 1
			end
			if i % 10 == 0 then task.wait() end
		end
		dumpAllBusy = false
		notify(("Volcado listo: %d guardados · %d sin código → %s/"):format(ok, fail, base), ok > 0 and "good" or "bad")
	end)
end

-- DUMP TOTAL: código + require() + entorno + closures + upvalues/constantes + funciones en memoria (GC)
local function dumpFull(inst)
	local out = {}
	local function L(s) out[#out + 1] = s end
	L("--[[ ═══════ R4N Explorer · DUMP TOTAL ═══════")
	L(" Ruta      : " .. getPath(inst))
	L(" FullName  : " .. inst:GetFullName())
	L(" Clase     : " .. inst.ClassName)
	pcall(function() if inst:IsA("Script") then L(" RunContext: " .. tostring(inst.RunContext)) end end)
	pcall(function() if not inst:IsA("ModuleScript") then L(" Disabled  : " .. tostring(inst.Disabled)) end end)
	if getscriptbytecode then
		local ok, b = pcall(getscriptbytecode, inst)
		if ok and type(b) == "string" then L((" Bytecode  : %d bytes"):format(#b)) end
	end
	if getscripthash then
		local ok, h = pcall(getscripthash, inst)
		if ok and h then L(" Hash      : " .. tostring(h)) end
	end
	local okA, attrs = pcall(function() return inst:GetAttributes() end)
	if okA and type(attrs) == "table" and next(attrs) then L(" Atributos : " .. ser(attrs, { maxDepth = 2 }):gsub("%s*\n%s*", " ")) end
	L("]]")
	L("")
	L("-- ═══════ 1) CÓDIGO ═══════")
	local src, method, log = fetchSource(inst)
	if src then
		L("-- método: " .. method)
		L(src)
	else
		L("-- (sin código) intentos:")
		for _, l in ipairs(log) do L("--   " .. l) end
	end
	if inst:IsA("ModuleScript") then
		L("")
		L("-- ═══════ 2) VALOR DEVUELTO POR require() ═══════")
		local ok, res = withTimeout(function() return require(inst) end, 8)
		if ok then
			L("-- tipo: " .. typeof(res))
			if res == nil then L("-- el módulo no devuelve ningún valor") end
			L("return " .. ser(res, { maxDepth = 7, maxEntries = 500, maxNodes = 30000, fnDetail = true }))
		else
			L("-- require() falló: " .. tostring(res))
		end
	end
	if getsenv then
		local ok, e = pcall(getsenv, inst)
		if ok and type(e) == "table" then
			L("")
			L("-- ═══════ 3) ENTORNO DEL SCRIPT (getsenv) ═══════")
			L(ser(e, { maxDepth = 3, maxEntries = 200, fnDetail = true }))
		end
	end
	if not (method or ""):find("constantes", 1, true) and getscriptclosure then
		local ok, f = pcall(getscriptclosure, inst)
		if ok and type(f) == "function" then
			L("")
			L("-- ═══════ 4) BYTECODE: función principal, upvalues, constantes ═══════")
			L(X.describe(f, "principal", 0))
		end
	end
	if getgc and getfenv then
		L("")
		L("-- ═══════ 5) FUNCIONES EN MEMORIA (getgc) QUE PERTENECEN A ESTE SCRIPT ═══════")
		local ok, gc = pcall(getgc, true)
		if ok and type(gc) == "table" then
			local found, state = 0, { n = 0 }
			for i = 1, #gc do
				if i % 20000 == 0 then task.wait() end
				local v = gc[i]
				if type(v) == "function" then
					local okf, fe = pcall(getfenv, v)
					if okf and type(fe) == "table" then
						local oks, sc = pcall(function() return fe.script end)
						if oks and sc == inst then
							found += 1
							if found > 80 then L("-- … (más funciones omitidas)") break end
							L(X.describe(v, "gc #" .. found, 0, state))
						end
					end
				end
			end
			if found == 0 then L("-- (ninguna encontrada: el script no ha creado funciones en memoria)") end
		end
	end
	local okC, ch = pcall(function() return inst:GetDescendants() end)
	if okC and #ch > 0 then
		L("")
		L("-- ═══════ 6) HIJOS ═══════")
		for i, d in ipairs(ch) do
			if i > 60 then L("-- … +" .. (#ch - 60) .. " más") break end
			L("-- " .. d.ClassName .. "  " .. d:GetFullName())
		end
	end
	return table.concat(out, "\n")
end

