local V = { lines = {}, hl = {}, n = 0, canvasW = 100 }
local codeRows, numRows = {}, {}
local lastSource, lastName, curScript, loadTok = "", "script", nil, 0

local function renderCode()
	local cy = codeScroll.CanvasPosition.Y
	local viewH = codeScroll.AbsoluteSize.Y
	local first = math.max(1, math.floor(cy / LH) + 1)
	local needRows = math.ceil(viewH / LH) + 2
	for i = 1, math.max(needRows, #codeRows) do
		local ln = first + i - 1
		local cr, nr = codeRows[i], numRows[i]
		if i <= needRows and ln <= V.n then
			if not cr then
				cr = new("TextLabel", {
					BackgroundTransparency = 1, Font = MONO, TextSize = TS, RichText = true, TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = SYN.text, TextWrapped = false, BorderSizePixel = 0, Text = "",
				}, codeScroll)
				nr = new("TextLabel", {
					BackgroundTransparency = 1, Font = MONO, TextSize = TS, TextXAlignment = Enum.TextXAlignment.Right,
					TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = Color3.fromRGB(125, 125, 125), BorderSizePixel = 0, Text = "",
				}, gutter)
				codeRows[i], numRows[i] = cr, nr
			end
			cr.Size = UDim2.fromOffset(V.canvasW, LH)
			cr.Position = UDim2.fromOffset(6, (ln - 1) * LH)
			cr.Text = V.hl[ln] or esc(V.lines[ln])
			cr.Visible = true
			nr.Size = UDim2.new(1, -6, 0, LH)
			nr.Position = UDim2.fromOffset(0, (ln - 1) * LH - cy)
			nr.Text = tostring(ln)
			nr.Visible = true
		else
			if cr then cr.Visible = false end
			if nr then nr.Visible = false end
		end
	end
end
connect(codeScroll:GetPropertyChangedSignal("CanvasPosition"), renderCode)
connect(codeScroll:GetPropertyChangedSignal("AbsoluteSize"), renderCode)

local function setCode(src, info)
	lastSource = src
	src = src:gsub("\r\n", "\n")
	src = src:gsub("\r", "\n")
	local lines, maxLen = {}, 0
	for raw in (src .. "\n"):gmatch("(.-)\n") do
		local line = raw:gsub("\t", "    ")
		line = line:gsub("[\0-\8\11-\31]", "")
		if not utf8.len(line) then line = line:gsub("[\128-\255]", "?") end
		if #line > MAXCOL then line = line:sub(1, MAXCOL) .. " …" end
		lines[#lines + 1] = line
		if #line > maxLen then maxLen = #line end
	end
	local my = { lines = lines, hl = {}, n = #lines }
	V = my
	local gw = math.max(34, #tostring(my.n) * CW + 14)
	gutter.Size = UDim2.new(0, gw, 1, -30 - 20)
	codeScroll.Position = UDim2.fromOffset(4 + gw, 30)
	codeScroll.Size = UDim2.new(1, -(8 + gw), 1, -30 - 20)
	my.canvasW = math.max(codeScroll.AbsoluteSize.X, maxLen * CW + 30)
	codeScroll.CanvasSize = UDim2.fromOffset(my.canvasW, my.n * LH + 10)
	codeScroll.CanvasPosition = Vector2.zero
	sInfo.Text = (info or "") .. (info and info ~= "" and " · " or "") .. my.n .. " líneas"
	renderCode()
	-- resaltado en segundo plano (por tandas para no congelar el juego)
	task.spawn(function()
		local st = {}
		local limit = math.min(my.n, 30000)
		for i = 1, limit do
			if V ~= my or not alive then return end
			local ok, r = pcall(hlLine, lines[i], st)
			my.hl[i] = ok and r or nil
			if i % 300 == 0 then
				task.wait()
				if V == my then renderCode() end
			end
		end
		if V == my then renderCode() end
	end)
end

-- obtención del código ------------------------------------------------------------
local function withTimeout(fn, sec)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(fn)
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < sec do task.wait() end
	if not done then return false, "tiempo agotado (" .. sec .. "s)" end
	return ok, res
end

local function looksFailed(s)
	if s:match("^%s*$") then return true end
	if #s < 600 then
		local h = s:lower()
		if h:find("failed to decompile", 1, true) or h:find("decompilation failed", 1, true)
			or h:find("unable to decompile", 1, true) or h:find("cannot decompile", 1, true) then
			return true
		end
	end
	return false
end

-- último recurso: constantes del bytecode (strings/números/nombres) si no hay decompilador
local function dumpClosure(inst)
	local getc = getscriptclosure or getscriptfunction
	if not getc or not (debug and debug.getconstants) then return nil end
	local ok, f = pcall(getc, inst)
	if not ok or type(f) ~= "function" then return nil end
	local out = { "-- No se pudo decompilar. Constantes encontradas en el bytecode (debug.getconstants):" }
	local seen, total = {}, 0
	local function walk(fn, depth, label)
		if depth > 3 or seen[fn] or total > 4000 then return end
		seen[fn] = true
		out[#out + 1] = "\n-- " .. string.rep("  ", depth) .. label
		local okc, cs = pcall(debug.getconstants, fn)
		if okc and type(cs) == "table" then
			local keys = {}
			for k in pairs(cs) do keys[#keys + 1] = k end
			table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
			for _, k in ipairs(keys) do
				local v = cs[k]
				if type(v) == "string" or type(v) == "number" then
					total += 1
					out[#out + 1] = string.rep("  ", depth) .. (type(v) == "string" and ("%q"):format(v) or tostring(v))
				end
			end
		end
		if debug.getprotos then
			local okp, ps = pcall(debug.getprotos, fn)
			if okp and type(ps) == "table" then
				for idx2, p in ipairs(ps) do walk(p, depth + 1, "función #" .. idx2) end
			end
		end
	end
	walk(f, 0, "principal")
	return #out > 1 and table.concat(out, "\n") or nil
end

local function fetchSource(inst)
	local log = {}
	local function attempt(name, fn)
		local ok, r = withTimeout(fn, 12)
		if ok and type(r) == "string" and not looksFailed(r) then return r end
		local why
		if not ok then why = tostring(r)
		elseif type(r) ~= "string" then why = "devolvió " .. type(r)
		elseif r:match("^%s*$") then why = "vacío"
		else why = "falló: " .. r:sub(1, 80):gsub("\n", " ") end
		log[#log + 1] = name .. " → " .. why
	end
	local src
	if type(decompile) == "function" then
		src = attempt("decompile()", function() return decompile(inst) end)
		if src then return src, "decompile()", log end
	else
		log[#log + 1] = "decompile() → no existe en tu executor"
	end
	src = attempt(".Source", function() return inst.Source end)
	if src then return src, ".Source", log end
	if type(getscriptbytecode) == "function" and type(decompile) == "function" then
		src = attempt("decompile(bytecode)", function() return decompile(getscriptbytecode(inst)) end)
		if src then return src, "decompile(bytecode)", log end
	end
	local okd, dump = pcall(dumpClosure, inst)
	if okd and dump then return dump, "constantes (sin decompilador)", log end
	return nil, nil, log
end

loadScript = function(inst)
	if not inst or not inst:IsA("LuaSourceContainer") then notify("Selecciona un script", "warn") return end
	lastName = inst.Name
	curScript = inst
	loadTok += 1
	local my = loadTok
	task.spawn(function()
		setCode("-- obteniendo el código de " .. inst:GetFullName() .. " ...", "cargando")
		local src, method, log = fetchSource(inst)
		if my ~= loadTok or not alive then return end
		if src then
			lastName = inst.Name
			setCode(src, inst.ClassName .. " " .. inst.Name .. " · " .. method)
			lastSource = src
		else
			local msg = { "-- No se pudo obtener el código de " .. inst:GetFullName(), "--" }
			for _, l in ipairs(log) do msg[#msg + 1] = "--   " .. l end
			msg[#msg + 1] = "--"
			msg[#msg + 1] = "-- Posibles causas: tu executor no soporta decompile(), el script está vacío/sin bytecode"
			msg[#msg + 1] = "-- (p. ej. un Script de servidor) o el nivel de identidad no permite leer .Source."
			if inst:IsA("ModuleScript") then msg[#msg + 1] = "-- Es un ModuleScript: prueba el botón «Dump módulo» para ver lo que devuelve." end
			setCode(table.concat(msg, "\n"), inst.ClassName .. " " .. inst.Name .. " · sin código")
			lastSource = ""
		end
	end)
end

button(sBar, "Decompilar", function()
	local target = (selected and selected:IsA("LuaSourceContainer")) and selected or curScript
	if target then loadScript(target) else notify("Selecciona un script en el Explorer", "warn") end
end, { TextSize = 13 })
