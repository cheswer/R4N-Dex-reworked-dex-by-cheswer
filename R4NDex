local acc = 0
connect(RunService.Heartbeat, function(dt)
	if not alive or not gui.Enabled then return end
	acc += dt
	if dirty and searchText == "" and windows.Explorer.frame.Visible and os.clock() - lastBuild > 0.35 then
		dirty, lastBuild = false, os.clock()
		rebuild()
		render()
	end
	if acc >= 0.5 then
		acc = 0
		if windows.Properties.frame.Visible then
			for _, e in ipairs(entries) do refreshEntry(e) end
		end
	end
end)

connect(UIS.InputBegan, function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift then
		gui.Enabled = not gui.Enabled
		return
	end
	if isPress(i) then
		local p = pointer(i)
		-- cerrar el menú contextual si se pulsa fuera de él
		if menu.Visible then
			local a, s = menu.AbsolutePosition, menu.AbsoluteSize
			if not (p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y) then menu.Visible = false end
		end
		-- traer al frente la ventana pulsada
		local best
		for _, w in pairs(windows) do
			local f = w.frame
			if f.Visible then
				local a, s = f.AbsolutePosition, f.AbsoluteSize
				if p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y and (not best or f.ZIndex > best.ZIndex) then
					best = f
				end
			end
		end
		if best and best.ZIndex < topZ then
			topZ += 1
			best.ZIndex = topZ
		end
	end
end)

