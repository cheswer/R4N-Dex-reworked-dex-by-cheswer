local acc = 0
connect(RunService.Heartbeat, function(dt)
	if not alive or minimized or not gui.Enabled then return end
	acc += dt
	if dirty and searchText == "" and os.clock() - lastBuild > 0.35 then
		dirty, lastBuild = false, os.clock()
		rebuild()
		render()
	end
	if acc >= 0.5 then
		acc = 0
		if tabs.current == "Props" then
			for _, e in ipairs(entries) do refreshEntry(e) end
		end
	end
end)

connect(UIS.InputBegan, function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift then gui.Enabled = not gui.Enabled end
end)

local function destroy()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function() hl:Destroy() end)
	pcall(function() gui:Destroy() end)
	env.R4NDex = nil
end
closeBtn.Activated:Connect(destroy)
env.R4NDex = { Destroy = destroy }

showTab("Props")
rebuild()
render()
notify("R4N Dex listo · RightShift para ocultar", "good")
