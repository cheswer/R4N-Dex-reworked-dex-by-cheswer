local function viewInst(inst)
	local c = Workspace.CurrentCamera
	local target
	if inst:IsA("Humanoid") or inst:IsA("BasePart") then target = inst
	elseif inst:IsA("Model") then target = inst:FindFirstChildWhichIsA("Humanoid") or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true) end
	if target then c.CameraSubject = target notify("Viendo: " .. inst.Name, "good") else notify("No se puede ver", "warn") end
end
local function unview()
	local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
	if h then Workspace.CurrentCamera.CameraSubject = h notify("Cámara restaurada", "good") end
end
local function cloneInst(i)
	local ok, c = pcall(function() return i:Clone() end)
	if ok and c then c.Parent = i.Parent notify("Clonado", "good") rebuild() render() else notify("No clonable", "bad") end
end
local function deleteInst(i)
	local ok = pcall(function() i:Destroy() end)
	notify(ok and "Eliminado" or "No se pudo borrar", ok and "good" or "bad")
	if selected == i then selected = nil buildProps(nil) end
	rebuild() render()
end
