	local function tick(force)
		if force or os.clock() - slice > 0.012 then
			rrender()
			task.wait()
			slice = os.clock()
		end
	end
	local opts = { case = DS.case, pat = DS.pat }

	if DS.code or DS.consts then
		local scripts = scriptList()
		for si, inst in ipairs(scripts) do
			if not alive2() then return end
			if si % 3 == 0 or si == #scripts then setProg((si / #scripts) * 0.7, ("Escaneando scripts %d/%d · %s · %d resultados"):format(si, #scripts, inst.Name, #results)) end
			local found = 0
			local method
			if DS.code then
				local src, mth = X.fetch(inst, false)
				method = mth
				scanned += 1
				if not src then failed += 1
				elseif m.quick(src) then
					local ln, pos = 1, 1
					while true do
						local e = src:find("\n", pos, true)
						local line = src:sub(pos, e and e - 1 or #src)
						if #line > 0 then
							local a, b = m.find(line)
							if a then
								found += 1
								if found <= 40 then
									add({ kind = "code", inst = inst, line = ln, find = q, opts = opts,
										title = titleFor(inst, ' <font color="#ffa050">:' .. ln .. "</font>"), snip = hlSnippet(line, a, b) })
								end
							end
						end
						if not e or #results >= MAXRES then break end
						pos = e + 1
						ln += 1
					end
				end
			end
			if DS.consts and (found == 0 or (method or ""):find("constantes", 1, true)) then
				for _, c in ipairs(scriptConstants(inst)) do
					local a, b = m.find(c)
					if a then
						found += 1
						if found <= 40 then
							add({ kind = "const", inst = inst, find = c, opts = { case = true }, title = titleFor(inst, ' <font color="#70c0ff">const</font>'), snip = hlSnippet(c, a, b) })
						end
					end
				end
			end
			if found > 0 then hitScripts += 1 end
			if found > 40 then
				add({ kind = "code", inst = inst, line = 1, find = q, opts = opts, title = titleFor(inst, ' <font color="#ffa050">+' .. (found - 40) .. " más</font>"), snip = "(abre el script para ver todas)" })
			end
			tick()
			if #results >= MAXRES then break end
		end
	end

	if (DS.names or DS.values) and alive2() and #results < MAXRES then
		setProg(0.72, "Escaneando instancias…")
		local pool2 = {}
		pcall(function()
			if DS.scope then
				pool2[1] = DS.scope
				for _, d in ipairs(DS.scope:GetDescendants()) do pool2[#pool2 + 1] = d end
			else
				for _, d in ipairs(game:GetDescendants()) do pool2[#pool2 + 1] = d end
				if getnilinstances then
					for _, d in ipairs(getnilinstances()) do
						pool2[#pool2 + 1] = d
						for _, dd in ipairs(d:GetDescendants()) do pool2[#pool2 + 1] = dd end
					end
				end
			end
		end)
		for i, inst in ipairs(pool2) do
			if i % 2000 == 0 then
				if not alive2() then return end
				setProg(0.72 + 0.2 * (i / #pool2), ("Instancias %d/%d · %d resultados"):format(i, #pool2, #results))
				tick(true)
			end
			if DS.names then
				local a, b = m.find(inst.Name)
				if a then
					add({ kind = "name", inst = inst, title = X.escRT(inst.Name) .. ' <font color="#7a7a7a">[' .. inst.ClassName .. "]</font>", snip = X.escRT(pathOf(inst)) })
				end
			end
			if DS.values then
				for _, kv in ipairs(instValues(inst)) do
					local a, b = m.find(kv[2])
					if a then
						add({ kind = "value", inst = inst, title = titleFor(inst, ' <font color="#70c0ff">' .. X.escRT(kv[1]) .. "</font>"), snip = hlSnippet(kv[2], a, b) })
					end
				end
			end
			if #results >= MAXRES then break end
		end
	end

	if DS.gc and getgc and alive2() and #results < MAXRES then
		setProg(0.93, "Escaneando memoria (getgc)…")
		local ok, gc = pcall(getgc, true)
		local gcHits = 0
		if ok and type(gc) == "table" then
			for i = 1, #gc do
				if i % 4000 == 0 then
					if not alive2() then return end
					setProg(0.93 + 0.06 * (i / #gc), ("Memoria %d/%d · %d resultados"):format(i, #gc, #results))
					tick(true)
				end
				local v = gc[i]
				local tv = type(v)
				if tv == "table" then
					local n = 0
					pcall(function()
						for k, val in next, v do
							n += 1
							if n > 200 then break end
							local label, txt
							if type(k) == "string" and #k < 300 and m.find(k) then label, txt = "clave", k
							elseif type(val) == "string" and #val < 300 and m.find(val) then label, txt = "valor [" .. tostring(k) .. "]", val end
							if label then
								gcHits += 1
								local a, b = m.find(txt)
								add({ kind = "gc", value = v, title = "tabla · " .. X.escRT(label), snip = hlSnippet(txt, a or 1, b or #txt) })
								break
							end
						end
					end)
				elseif tv == "function" then
					local info = X.fnInfo(v)
					local hit, txt = nil, nil
					if info.name ~= "" and m.find(info.name) then hit, txt = "nombre", info.name end
					if not hit and info.kind == "Lua" then
						for _, c in ipairs(X.constList(v, 80)) do
							local plain = c:gsub('^"', ""):gsub('"$', "")
							if m.find(plain) then hit, txt = "constante", plain break end
						end
					end
					if hit then
						gcHits += 1
						local a, b = m.find(txt)
						add({ kind = "gc", value = v, title = "función · " .. hit .. (info.name ~= "" and (" «" .. X.escRT(info.name) .. "»") or ""), snip = hlSnippet(txt, a or 1, b or #txt) })
					end
				end
				if gcHits >= 400 or #results >= MAXRES then break end
			end
		end
	end

	running = false
	rrender()
	setProg(1)
	statLbl.Text = ("%d resultados%s · %d scripts con coincidencias · %d escaneados (%d sin código) · %.1fs"):format(
		#results, #results >= MAXRES and "+" or "", hitScripts, scanned, failed, os.clock() - t0)
end

