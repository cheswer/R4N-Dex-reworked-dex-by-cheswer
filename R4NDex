X.collectScripts = function(force)
	local scriptCache = X.scriptCache
	if not force and os.clock() - scriptCache.t < 6 then return scriptCache.list end
	local t, seen = {}, {}
	local function add(s)
		if typeof(s) == "Instance" and not seen[s] then
			seen[s] = true
			t[#t + 1] = s
		end
	end
	if getscripts then pcall(function() for _, s in ipairs(getscripts()) do add(s) end end) end
	if getloadedmodules then pcall(function() for _, s in ipairs(getloadedmodules()) do add(s) end end) end
	pcall(function()
		for _, d in ipairs(game:GetDescendants()) do
			if d:IsA("LuaSourceContainer") then add(d) end
		end
	end)
	if getnilinstances then
		pcall(function()
			for _, d in ipairs(getnilinstances()) do
				if d:IsA("LuaSourceContainer") then add(d) end
			end
		end)
	end
	scriptCache.t, scriptCache.list = os.clock(), t
	return t
end
