-- formateo / serialización ---------------------------------------------------
local function r3(n) return math.floor(n * 1000 + 0.5) / 1000 end
local function fmt(v)
	local t = typeof(v)
	if t == "Color3" then
		return ("%d, %d, %d"):format(math.floor(v.R * 255 + .5), math.floor(v.G * 255 + .5), math.floor(v.B * 255 + .5))
	elseif t == "Vector3" then return ("%s, %s, %s"):format(r3(v.X), r3(v.Y), r3(v.Z))
	elseif t == "Vector2" then return ("%s, %s"):format(r3(v.X), r3(v.Y))
	elseif t == "UDim2" then return ("%s, %s, %s, %s"):format(r3(v.X.Scale), v.X.Offset, r3(v.Y.Scale), v.Y.Offset)
	elseif t == "UDim" then return ("%s, %s"):format(r3(v.Scale), v.Offset)
	elseif t == "CFrame" then
		local c = { v:GetComponents() }
		for i = 1, #c do c[i] = r3(c[i]) end
		return table.concat(c, ", ")
	elseif t == "EnumItem" or t == "BrickColor" then return v.Name
	elseif t == "Instance" then return v:GetFullName()
	elseif t == "string" then return v
	end
	return tostring(v)
end

local function nums(s)
	local out = {}
	for m in s:gmatch("[%-%+%d%.eE]+") do
		local n = tonumber(m)
		if n then out[#out + 1] = n end
	end
	return out
end
local function parseFor(old, s)
	local t = typeof(old)
	if t == "string" then return s
	elseif t == "number" then return tonumber(s)
	elseif t == "Color3" then
		if s:match("^#?%x%x%x%x%x%x$") then return Color3.fromHex(s) end
		local n = nums(s)
		if #n == 3 then return Color3.fromRGB(n[1], n[2], n[3]) end
	elseif t == "Vector3" then local n = nums(s); if #n == 3 then return Vector3.new(n[1], n[2], n[3]) end
	elseif t == "Vector2" then local n = nums(s); if #n == 2 then return Vector2.new(n[1], n[2]) end
	elseif t == "UDim2" then local n = nums(s); if #n == 4 then return UDim2.new(n[1], n[2], n[3], n[4]) end
	elseif t == "UDim" then local n = nums(s); if #n == 2 then return UDim.new(n[1], n[2]) end
	elseif t == "CFrame" then
		local n = nums(s)
		if #n == 3 or #n == 12 then return CFrame.new(table.unpack(n)) end
	elseif t == "EnumItem" then
		for _, it in ipairs(old.EnumType:GetEnumItems()) do
			if it.Name:lower() == s:lower() then return it end
		end
	elseif t == "BrickColor" then
		local ok, bc = pcall(BrickColor.new, s)
		if ok then return bc end
	end
	return nil
end

local function idx(n)
	if n:match("^[%a_][%w_]*$") then return "." .. n end
	return '["' .. n:gsub("\\", "\\\\"):gsub('"', '\\"') .. '"]'
end
local function getPath(i)
	local chain, c = {}, i
	while c and c ~= game do
		table.insert(chain, 1, c)
		c = c.Parent
	end
	if c ~= game then return "--[[sin padre]] " .. i:GetFullName() end
	local s = "game"
	for k, inst in ipairs(chain) do
		if k == 1 then s = s .. ':GetService("' .. inst.ClassName .. '")' else s = s .. idx(inst.Name) end
	end
	return s
end

local function ser(v, depth, seen)
	depth, seen = depth or 0, seen or {}
	local t = typeof(v)
	if t == "string" then return ("%q"):format(v)
	elseif t == "number" or t == "boolean" or t == "nil" then return tostring(v)
	elseif t == "Instance" then return getPath(v)
	elseif t == "Vector3" then return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z)
	elseif t == "Vector2" then return ("Vector2.new(%s, %s)"):format(v.X, v.Y)
	elseif t == "CFrame" then return "CFrame.new(" .. table.concat({ v:GetComponents() }, ", ") .. ")"
	elseif t == "Color3" then return ("Color3.new(%s, %s, %s)"):format(v.R, v.G, v.B)
	elseif t == "UDim2" then return ("UDim2.new(%s, %s, %s, %s)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
	elseif t == "EnumItem" then return tostring(v)
	elseif t == "BrickColor" then return ('BrickColor.new("%s")'):format(v.Name)
	elseif t == "table" then
		if depth > 4 or seen[v] then return "{...}" end
		seen[v] = true
		local out = {}
		for k, val in pairs(v) do
			local ks = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k or ("[" .. ser(k, depth + 1, seen) .. "]")
			out[#out + 1] = string.rep("  ", depth + 1) .. ks .. " = " .. ser(val, depth + 1, seen)
			if #out >= 250 then out[#out + 1] = string.rep("  ", depth + 1) .. "-- ... (recortado)"; break end
		end
		seen[v] = nil
		if #out == 0 then return "{}" end
		return "{\n" .. table.concat(out, ",\n") .. "\n" .. string.rep("  ", depth) .. "}"
	end
	return "nil --[[" .. t .. "]]"
end

local function copy(str)
	local f = setclipboard or toclipboard
	if f then f(str) return true end
	return false
end

