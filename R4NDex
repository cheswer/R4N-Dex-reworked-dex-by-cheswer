local hookOk = false
if hookmetamethod and getnamecallmethod then
	local ok = pcall(function()
		local old
		old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
			local method = getnamecallmethod()
			if alive and (method == "FireServer" or method == "InvokeServer") and not (checkcaller and checkcaller()) then
				local okc, cn = pcall(function() return self.ClassName end)
				if okc and (cn == "RemoteEvent" or cn == "RemoteFunction" or cn == "UnreliableRemoteEvent") then
					if blocked[self] then return end
					if spyOn then task.defer(addLog, self, method, table.pack(...)) end
				end
			end
			return old(self, ...)
		end))
	end)
	hookOk = ok
end
if not hookOk then
	rDetailText.Text = "⚠ Tu executor no soporta hookmetamethod/getnamecallmethod: el Remote Spy está desactivado."
	rDetailText.TextColor3 = C.warn
end

