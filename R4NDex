		LayoutOrder = logN,
	}, rList)
	e.btn = b
	b.Activated:Connect(function()
		logSel = e
		rDetailText.TextColor3 = C.text
		rDetailText.Text = genCode(e)
	end)
	if #logs > 250 then
		local old = table.remove(logs, 1)
		if old.btn then old.btn:Destroy() end
	end
	rList.CanvasPosition = Vector2.new(0, 1e6)
end

