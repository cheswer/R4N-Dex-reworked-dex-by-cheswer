local function genCode(e)
	local parts = {}
	for i = 1, e.args.n do parts[i] = ser(e.args[i]) end
	return ("local args = {%s}\n%s:%s(unpack(args, 1, %d))"):format(table.concat(parts, ", "), getPath(e.remote), e.method, e.args.n)
end
local function addLog(remote, method, args)
	if not alive then return end
	logN += 1
	local e = { remote = remote, method = method, args = args }
	logs[#logs + 1] = e
	local b = new("TextButton", {
