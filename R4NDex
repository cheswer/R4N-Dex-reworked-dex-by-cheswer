local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function pointer(i)
	local ok, p = pcall(function() return UIS:GetMouseLocation() end)
	if ok and p then return p end
	return Vector2.new(i.Position.X, i.Position.Y)
end

local function makeDraggable(handle, onStart, onDelta)
	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			local start = input.Position
			local state = onStart()
			local con
			con = UIS.InputChanged:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
					onDelta(state, i.Position.X - start.X, i.Position.Y - start.Y)
				end
			end)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then con:Disconnect() end
			end)
		end
	end)
end

local function addWindow(key, title, x, y, w, h, minW, minH)
	local f = new("Frame", {
		Name = key, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = C.panel,
		BorderSizePixel = 0, ClipsDescendants = true, Visible = false, Active = true,
	}, gui)
	stroke(f, C.line)
	local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = C.title, BorderSizePixel = 0 }, f)
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = C.line, BorderSizePixel = 0 }, bar)
	local ttl = text(bar, title, { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -32, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	local cl = new("TextButton", {
		Text = "✕", Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -22, 0, 0), BackgroundTransparency = 1,
		TextColor3 = C.dim, Font = FONT, TextSize = 13, AutoButtonColor = false, BorderSizePixel = 0,
	}, bar)
	cl.MouseEnter:Connect(function() cl.BackgroundTransparency = 0 cl.BackgroundColor3 = C.bad cl.TextColor3 = C.text end)
	cl.MouseLeave:Connect(function() cl.BackgroundTransparency = 1 cl.TextColor3 = C.dim end)
	cl.Activated:Connect(function() f.Visible = false end)

	local content = new("Frame", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 1, -22), BackgroundTransparency = 1, ClipsDescendants = true }, f)

	makeDraggable(bar, function() return f.Position end, function(sp, dx, dy)
		f.Position = UDim2.new(sp.X.Scale, sp.X.Offset + dx, sp.Y.Scale, sp.Y.Offset + dy)
	end)
	local grip = new("TextButton", {
		Text = "◢", TextColor3 = C.dim, BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -16, 1, -16),
		ZIndex = 50, TextSize = 12, Font = FONT, AutoButtonColor = false,
	}, f)
	makeDraggable(grip, function() return f.AbsoluteSize end, function(sz, dx, dy)
		f.Size = UDim2.fromOffset(math.max(minW or 240, sz.X + dx), math.max(minH or 160, sz.Y + dy))
	end)

	windows[key] = { frame = f, content = content, title = ttl }
	return content
end

local function showTab(name)
