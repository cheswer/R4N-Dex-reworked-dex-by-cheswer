		for _, r in ipairs(rootList) do
			if n >= 3000 then break end
			test(r)
			local ok2, desc = pcall(function() return r:GetDescendants() end)
			if ok2 then
				for _, d in ipairs(desc) do
					if n >= 3000 then break end
					test(d)
				end
			end
		end
	else
		table.sort(rootList, byName)
		for _, r in ipairs(rootList) do add(r, 0) end
	end
end

local lastClick = { t = 0, i = nil }
local function toggle(inst)
	if not inst then return end
	expanded[inst] = (not expanded[inst]) or nil
	rebuild()
	render()
end

local function paintRow(r)
	if r.inst and r.inst == selected then
		r.frame.BackgroundColor3, r.frame.BackgroundTransparency = C.sel, 0
	elseif r.hover then
		r.frame.BackgroundColor3, r.frame.BackgroundTransparency = C.hover, 0
	else
		r.frame.BackgroundTransparency = 1
	end
end

local function makeRow()
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW), BackgroundColor3 = C.sel, BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, BorderSizePixel = 0, Visible = false,
	}, list)
	local arrow = new("TextButton", { Size = UDim2.fromOffset(16, ROW), BackgroundTransparency = 1, Text = "", TextColor3 = C.dim, Font = FONT, TextSize = 14, AutoButtonColor = false }, row)
	local badge = new("TextLabel", { Size = UDim2.fromOffset(18, ROW), BackgroundTransparency = 1, Text = "", TextColor3 = Color3.new(1, 1, 1), Font = FONT, TextSize = 14, BorderSizePixel = 0 }, row)
	local name = text(row, "", { TextTruncate = Enum.TextTruncate.AtEnd })
	local r = { frame = row, arrow = arrow, badge = badge, name = name, inst = nil, hover = false }
	row.MouseEnter:Connect(function() r.hover = true paintRow(r) end)
	row.MouseLeave:Connect(function() r.hover = false paintRow(r) end)
	row.Activated:Connect(function()
		local inst = r.inst
		if not inst then return end
		local now = os.clock()
		local dbl = lastClick.i == inst and now - lastClick.t < 0.4
		lastClick.i, lastClick.t = inst, now
		local scriptWasOpen = windows.Script.frame.Visible
		selectInst(inst)
		if dbl then
			lastClick.i = nil
			if inst:IsA("LuaSourceContainer") then
				showTab("Script")
				if not scriptWasOpen then loadScript(inst) end
			else
				toggle(inst)
			end
		end
	end)
	row.MouseButton2Click:Connect(function()
		if r.inst then
			selectInst(r.inst)
			openMenu(r.inst)
		end
	end)
	arrow.Activated:Connect(function() toggle(r.inst) end)
	return r
end

local function fillRow(r, item, y)
	local inst, depth = item[1], item[2]
	r.inst = inst
	local x = 4 + depth * 16
	r.frame.Position = UDim2.fromOffset(0, y)
	r.arrow.Position = UDim2.fromOffset(x, 0)
	r.arrow.Text = hasKids(inst) and (expanded[inst] and "▾" or "▸") or ""
	r.badge.Position = UDim2.fromOffset(x + 17, 0)
	r.badge.Text = X.icon(inst)
	r.name.Position = UDim2.fromOffset(x + 38, 0)
	r.name.Size = UDim2.new(1, -(x + 42), 1, 0)
	if (currentRoot.paths or searchText ~= "") and depth == 0 then
		local pp = "nil"
		pcall(function() if inst.Parent then pp = inst.Parent:GetFullName() end end)
		r.name.RichText = true
		r.name.Text = X.escRT(inst.Name) .. '  <font color="#7a7a7a">' .. X.escRT(pp) .. "</font>"
	else
		r.name.RichText = false
		r.name.Text = inst.Name
	end
	r.frame.Visible = true
	paintRow(r)
end

render = function()
	local first = math.max(1, math.floor(list.CanvasPosition.Y / ROW) + 1)
	local need = math.ceil(list.AbsoluteSize.Y / ROW) + 2
	list.CanvasSize = UDim2.fromOffset(0, #flat * ROW)
	for i = 1, math.max(need, #rows) do
		local item = flat[first + i - 1]
		if i <= need and item then
			local r = rows[i]
			if not r then r = makeRow(); rows[i] = r end
			fillRow(r, item, (first + i - 2) * ROW)
		elseif rows[i] then
			rows[i].frame.Visible = false
			rows[i].inst = nil
		end
	end
end
