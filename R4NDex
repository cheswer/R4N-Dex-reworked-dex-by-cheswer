local function showCode(str)
	lastSource = str
	for _, c in ipairs(codeScroll:GetChildren()) do
		if c:IsA("TextLabel") then c:Destroy() end
	end
	local chunk, count, order = {}, 0, 0
	local function flush()
		if #chunk == 0 then return end
		order += 1
		text(codeScroll, table.concat(chunk, "\n"), {
			Font = MONO, TextSize = 12, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -6, 0, 0),
			TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = order, TextColor3 = Color3.fromRGB(205, 215, 235),
		})
		chunk = {}
	end
	for line in (str .. "\n"):gmatch("(.-)\n") do
		count += 1
		line = line:gsub("\t", "  ")
		if #line > 400 then line = line:sub(1, 400) .. " …" end
		chunk[#chunk + 1] = ("%4d│ %s"):format(count, line)
		if #chunk >= 100 then flush() end
		if count >= 8000 then chunk[#chunk + 1] = "-- … recortado en 8000 líneas (usa Copiar/Guardar para el total)" break end
	end
	flush()
end

loadScript = function(inst)
	if not inst or not inst:IsA("LuaSourceContainer") then notify("Selecciona un script", "warn") return end
	lastName = inst.Name
	task.spawn(function()
		showCode("-- decompilando " .. inst.Name .. " ...")
		local src
		if decompile then
			local ok, r = pcall(decompile, inst)
			src = (ok and type(r) == "string") and r or ("-- error al decompilar: " .. tostring(r))
		else
			local ok, r = pcall(function() return inst.Source end)
			src = ok and r or "-- tu executor no tiene decompile()"
		end
		if src == "" then src = "-- (vacío)" end
		showCode(src)
	end)
end

