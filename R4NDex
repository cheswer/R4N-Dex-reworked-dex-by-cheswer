local function copyN(str, okMsg)
	if copy(str) then notify(okMsg, "good") else notify("Tu executor no tiene setclipboard", "bad") end
end
local function tpTo(inst)
	local char = LP.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then notify("No hay personaje", "bad") return end
	if inst:IsA("PVInstance") then
		hrp.CFrame = inst:GetPivot() + Vector3.new(0, 4, 0)
		notify("Teletransportado", "good")
	else
		notify("Solo Model/BasePart", "warn")
	end
