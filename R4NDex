local function refreshEntry(e)
	local ok, v = pcall(e.get)
	if not ok then return end
	local box = e.box
	if e.kind == "boolean" then
		box.Text = tostring(v)
		box.TextColor3 = v and C.good or C.bad
	elseif e.kind == "Instance" then
		box.Text = typeof(v) == "Instance" and v:GetFullName() or "nil"
	else
		if box:IsA("TextBox") and box:IsFocused() then return end
		box.Text = fmt(v)
	end
	if e.swatch then
		local col = typeof(v) == "BrickColor" and v.Color or v
		if typeof(col) == "Color3" then e.swatch.BackgroundColor3 = col end
	end
end

local function addProp(name, get, set, readonly)
	local ok, v = pcall(get)
	if not ok then return false end
	local kind = typeof(v)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = C.panel, BorderSizePixel = 0, LayoutOrder = nextOrder() }, propScroll)
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = C.line, BorderSizePixel = 0 }, row)
	new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(0.45, 0, 0, 0), BackgroundColor3 = C.line, BorderSizePixel = 0 }, row)
	text(row, name, { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.45, -10, 1, -1), TextColor3 = Color3.fromRGB(215, 215, 215), TextTruncate = Enum.TextTruncate.AtEnd })
	local e = { get = get, kind = kind, name = name, row = row }
	local hasSwatch = (kind == "Color3" or kind == "BrickColor")
	local boxW = hasSwatch and UDim2.new(0.55, -22, 1, -1) or UDim2.new(0.55, -1, 1, -1)
	local base = {
		Position = UDim2.new(0.45, 1, 0, 0), Size = boxW, BackgroundTransparency = 1, TextColor3 = C.text, Font = FONT, TextSize = 14,
		BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}
	local box
	if kind == "boolean" and not readonly then
		base.AutoButtonColor = false
		box = new("TextButton", base, row)
		box.Activated:Connect(function()
			local ok2, cur = pcall(get)
			if ok2 then set(not cur) refreshEntry(e) end
		end)
	elseif kind == "Instance" then
		base.AutoButtonColor = false
		base.TextColor3 = C.accent2
		box = new("TextButton", base, row)
		box.Activated:Connect(function()
			local ok2, cur = pcall(get)
			if ok2 and typeof(cur) == "Instance" then selectInst(cur) reveal(cur) end
		end)
	else
		base.ClearTextOnFocus = false
		base.TextEditable = not (readonly or kind == "nil")
		box = new("TextBox", base, row)
		box.Focused:Connect(function() box.BackgroundTransparency = 0 box.BackgroundColor3 = C.btn end)
		box.FocusLost:Connect(function(enter)
			box.BackgroundTransparency = 1
			if not enter or box.TextEditable == false then refreshEntry(e) return end
			local ok2, cur = pcall(get)
			local nv = ok2 and parseFor(cur, box.Text) or nil
			if nv == nil then notify("Valor inválido para " .. name .. " (" .. kind .. ")", "bad") else set(nv) end
			refreshEntry(e)
		end)
	end
	padding(box, 6, 0, 4, 0)
	e.box = box
	if hasSwatch then
		e.swatch = new("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -18, 0.5, -7), BackgroundColor3 = Color3.new(), BorderSizePixel = 0 }, row)
		stroke(e.swatch, C.line)
	end
	entries[#entries + 1] = e
	if curCat then curCat.entries[#curCat.entries + 1] = e end
	refreshEntry(e)
	return true
end

buildProps = function(inst)
	clearProps()
	if not inst then windows.Properties.title.Text = "Properties" return end
	windows.Properties.title.Text = "Properties - " .. inst.ClassName .. ' "' .. inst.Name .. '"'
	local seen = {}
	for _, def in ipairs(PROPS) do
		if inst:IsA(def[1]) then
			local started = false
			for _, pn in ipairs(def[2]) do
				if not seen[pn] then
					seen[pn] = true
					if not started then
						section(def[1] == "Instance" and "Data" or def[1])
						started = true
					end
					addProp(pn, function() return getProp(inst, pn) end, function(v) setProp(inst, pn, v) end, READONLY[pn])
				end
			end
		end
	end
	local ok, at = pcall(function() return inst:GetAttributes() end)
	if ok and next(at) then
		section("Attributes")
		for k in pairs(at) do
			addProp(k, function() return inst:GetAttribute(k) end, function(nv) inst:SetAttribute(k, nv) notify("Atributo " .. k .. " actualizado", "good") end)
		end
	end
	local ok2, tg = pcall(function() return CollectionService:GetTags(inst) end)
	if ok2 and #tg > 0 then
		section("Tags")
		local lbl = text(propScroll, "  " .. table.concat(tg, ", "), { Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.warn, LayoutOrder = nextOrder(), TextTruncate = Enum.TextTruncate.AtEnd })
		curCat.entries[#curCat.entries + 1] = { name = "tags", row = lbl }
	end
	applyVisibility()
end

