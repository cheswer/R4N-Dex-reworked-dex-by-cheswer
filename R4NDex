local function badgeFor(inst)
	if inst.Parent == game then return "◈", C.accent end
	for _, b in ipairs(BADGES) do
		if inst:IsA(b[1]) then return b[2], b[3] end
	end
	return inst.ClassName:sub(1, 1), Color3.fromRGB(90, 90, 112)
end

local function kids(inst)
	local ok, ch = pcall(function() return inst:GetChildren() end)
	return ok and ch or {}
end
local function hasKids(i)
	local ok, c = pcall(i.FindFirstChildWhichIsA, i, "Instance")
	return ok and c ~= nil
end
local function byName(a, b)
	local an, bn = a.Name:lower(), b.Name:lower()
	if an == bn then return a.ClassName < b.ClassName end
	return an < bn
end

local function add(inst, depth)
	flat[#flat + 1] = { inst, depth }
	if expanded[inst] then
		local ch = kids(inst)
		table.sort(ch, byName)
		for _, c in ipairs(ch) do add(c, depth + 1) end
	end
end

rebuild = function()
	table.clear(flat)
	local ok, res = pcall(currentRoot[2])
	local rootList = (ok and type(res) == "table") and res or {}
	if searchText ~= "" then
		local q, byClass, n = searchText:lower(), false, 0
		if q:sub(1, 2) == "c:" then byClass, q = true, q:sub(3) end
		local function test(i)
			local s = byClass and i.ClassName or i.Name
			if s:lower():find(q, 1, true) then
				n += 1
				flat[#flat + 1] = { i, 0 }
			end
		end
		for _, r in ipairs(rootList) do
			if n >= 3000 then break end
			test(r)
			local ok2, desc = pcall(function() return r:GetDescendants() end)
			if ok2 then
				for _, d in ipairs(desc) do
					if n >= 3000 then break end
					test(d)
				end
			end
		end
	else
		table.sort(rootList, byName)
		for _, r in ipairs(rootList) do add(r, 0) end
	end
end

local lastClick = { t = 0, i = nil }
local function toggle(inst)
	if not inst then return end
	expanded[inst] = (not expanded[inst]) or nil
	rebuild()
	render()
end

local function makeRow()
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, ROW), BackgroundColor3 = C.accent, BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, BorderSizePixel = 0, Visible = false,
	}, list)
	local arrow = new("TextButton", { Size = UDim2.fromOffset(16, ROW), BackgroundTransparency = 1, Text = "", TextColor3 = C.dim, Font = FONTB, TextSize = 11, AutoButtonColor = false }, row)
	local badge = new("TextLabel", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.dim, Text = "", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 10 }, row)
	corner(badge, 4)
	local name = text(row, "", { TextTruncate = Enum.TextTruncate.AtEnd })
	local cls = text(row, "", { TextColor3 = C.dim, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -84, 0, 0), Size = UDim2.new(0, 80, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	local r = { frame = row, arrow = arrow, badge = badge, name = name, cls = cls, inst = nil }
	row.Activated:Connect(function()
		local inst = r.inst
		if not inst then return end
		local now = os.clock()
		if lastClick.i == inst and now - lastClick.t < 0.4 then
			lastClick.i = nil
			toggle(inst)
		else
			lastClick.i, lastClick.t = inst, now
		end
		selectInst(inst)
	end)
	arrow.Activated:Connect(function() toggle(r.inst) end)
	return r
end

local function fillRow(r, item, y)
	local inst, depth = item[1], item[2]
	r.inst = inst
	local x = 2 + depth * 14
	r.frame.Position = UDim2.fromOffset(0, y)
	r.arrow.Position = UDim2.fromOffset(x, 0)
	r.arrow.Text = hasKids(inst) and (expanded[inst] and "▾" or "▸") or ""
	r.badge.Position = UDim2.fromOffset(x + 18, 3)
	local letter, col = badgeFor(inst)
	r.badge.Text, r.badge.BackgroundColor3 = letter, col
	r.name.Position = UDim2.fromOffset(x + 38, 0)
	r.name.Size = UDim2.new(1, -(x + 38 + 84), 1, 0)
	r.name.Text = inst.Name
	r.cls.Text = inst.ClassName
	r.frame.BackgroundTransparency = (inst == selected) and 0.6 or 1
	r.frame.Visible = true
end

render = function()
	local first = math.max(1, math.floor(list.CanvasPosition.Y / ROW) + 1)
	local need = math.ceil(list.AbsoluteSize.Y / ROW) + 2
	list.CanvasSize = UDim2.fromOffset(0, #flat * ROW)
	for i = 1, math.max(need, #rows) do
		local item = flat[first + i - 1]
		if i <= need and item then
			local r = rows[i]
			if not r then r = makeRow(); rows[i] = r end
			fillRow(r, item, (first + i - 2) * ROW)
		elseif rows[i] then
			rows[i].frame.Visible = false
			rows[i].inst = nil
		end
	end
end
connect(list:GetPropertyChangedSignal("CanvasPosition"), function() render() end)
