local KW = {}
for w in ("and break do else elseif end for function if in local not or repeat return then until while continue"):gmatch("%a+") do KW[w] = true end
local BUILTIN = {}
for w in ([[game workspace script math string table task os tick time print warn error pcall xpcall ipairs pairs next type typeof tostring tonumber
require select unpack setmetatable getmetatable rawget rawset rawequal rawlen wait spawn delay Instance Vector3 Vector2 CFrame Color3 UDim2 UDim Enum
Random bit32 coroutine utf8 debug assert newproxy shared _G Ray Region3 BrickColor TweenInfo NumberSequence ColorSequence Rect buffer
loadstring getgenv getrenv getfenv setfenv Drawing]]):gmatch("[%w_]+") do BUILTIN[w] = true end

local ESC = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }
local function esc(s) return (s:gsub("[&<>\"']", ESC)) end

-- resaltado por línea (st guarda el estado de comentarios/strings largos entre líneas)
local function hlLine(line, st)
	local out, plain = {}, {}
	local function flush()
		if #plain > 0 then out[#out + 1] = esc(table.concat(plain)) plain = {} end
	end
	local function col(c, s)
		if s == "" then return end
		flush()
		out[#out + 1] = '<font color="' .. HEX[c] .. '">' .. esc(s) .. "</font>"
	end
	local i, n, prev = 1, #line, nil
	while i <= n do
		if st.long then
			local close = "]" .. string.rep("=", st.long.eq) .. "]"
			local _, b = line:find(close, i, true)
			if b then col(st.long.kind, line:sub(i, b)) i = b + 1 st.long = nil
			else col(st.long.kind, line:sub(i)) i = n + 1 end
		else
			local c = line:sub(i, i)
			if c == "-" and line:sub(i + 1, i + 1) == "-" then
				local eq = line:match("^%-%-%[(=*)%[", i)
				if eq then
					st.long = { eq = #eq, kind = "comment" }
					col("comment", line:sub(i, i + 3 + #eq))
					i = i + 4 + #eq
				else
					col("comment", line:sub(i))
					i = n + 1
				end
			elseif c == '"' or c == "'" or c == "`" then
				local j = i + 1
				while j <= n do
					local ch = line:sub(j, j)
					if ch == "\\" then j = j + 2
					elseif ch == c then break
					else j = j + 1 end
				end
				col("string", line:sub(i, math.min(j, n)))
				i = j + 1
				prev = nil
			elseif c == "[" and line:match("^%[=*%[", i) then
				local eq = line:match("^%[(=*)%[", i)
				st.long = { eq = #eq, kind = "string" }
				col("string", line:sub(i, i + 1 + #eq))
				i = i + 2 + #eq
			elseif c:match("%d") or (c == "." and line:sub(i + 1, i + 1):match("%d")) then
				local s = line:match("^0[xX][%x_]+", i) or line:match("^0[bB][01_]+", i)
					or line:match("^%d[%d_]*%.?%d*[eE][%+%-]?%d+", i) or line:match("^%d[%d_]*%.?%d*", i)
					or line:match("^%.%d+", i) or c
				col("number", s)
				i = i + #s
				prev = nil
			elseif c:match("[%a_]") then
				local w = line:match("^[%a_][%w_]*", i)
				local nextc = line:match("^%s*(.)", i + #w)
				local cc
				if KW[w] then cc = "keyword"
				elseif prev == "function" then cc = "fname"
				elseif prev == "." or prev == ":" then cc = (nextc == "(") and "fname" or "prop"
				elseif w == "true" or w == "false" or w == "nil" then cc = "bool"
				elseif w == "self" then cc = "keyword"
				elseif BUILTIN[w] then cc = "builtin" end
				if cc then col(cc, w) else plain[#plain + 1] = w end
				prev = (w == "function") and "function" or nil
				i = i + #w
			elseif c == "." then
				if line:sub(i, i + 1) == ".." then
					local s = line:match("^%.%.%.?", i)
					plain[#plain + 1] = s
					i = i + #s
					prev = nil
				else
					plain[#plain + 1] = "."
					i = i + 1
					prev = "."
				end
			elseif c == ":" then
				if line:sub(i, i + 1) == "::" then
					plain[#plain + 1] = "::"
					i = i + 2
					prev = nil
				else
					plain[#plain + 1] = ":"
					i = i + 1
					prev = ":"
				end
			else
				plain[#plain + 1] = c
				i = i + 1
				if not c:match("%s") then prev = nil end
			end
		end
	end
	flush()
	return table.concat(out)
end

-- estado del visor ---------------------------------------------------------------
local V = { lines = {}, hl = {}, n = 0, canvasW = 100 }
local codeRows, numRows = {}, {}
local lastSource, lastName, curScript, loadTok = "", "script", nil, 0

-- resaltado de coincidencias (cajas amarillas sobre el texto, fuente monoespaciada) ----------------------
local hitFrames = {}
local function paintHits(i, ln, cr)
	local hs = F.byLine[ln]
	local pool = hitFrames[i]
	if not hs then
		if pool then for _, f in ipairs(pool) do f.Visible = false end end
		return
	end
	if not pool then pool = {} hitFrames[i] = pool end
	for k = 1, math.max(#hs, #pool) do
		local h, f = hs[k], pool[k]
		if h and k <= 8 then
			if not f then
				f = new("Frame", { BorderSizePixel = 0, ZIndex = 5 }, cr)
				pool[k] = f
			end
			local isCur = F.hits[F.cur] == h
			f.BackgroundColor3 = isCur and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(255, 198, 0)
			f.BackgroundTransparency = isCur and 0.4 or 0.72
			f.Position = UDim2.fromOffset((h.col - 1) * CW, 0)
			f.Size = UDim2.fromOffset(math.max(h.len * CW, 4), LH)
			f.Visible = true
		elseif f then
			f.Visible = false
		end
	end
end

local function renderCode()
	local cy = codeScroll.CanvasPosition.Y
	local viewH = codeScroll.AbsoluteSize.Y
	local first = math.max(1, math.floor(cy / LH) + 1)
	local needRows = math.ceil(viewH / LH) + 2
	for i = 1, math.max(needRows, #codeRows) do
		local ln = first + i - 1
		local cr, nr = codeRows[i], numRows[i]
		if i <= needRows and ln <= V.n then
			if not cr then
				cr = new("TextLabel", {
					BackgroundTransparency = 1, Font = MONO, TextSize = TS, RichText = true, TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = SYN.text, TextWrapped = false, BorderSizePixel = 0, Text = "",
				}, codeScroll)
				nr = new("TextLabel", {
					BackgroundTransparency = 1, Font = MONO, TextSize = TS, TextXAlignment = Enum.TextXAlignment.Right,
					TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = Color3.fromRGB(125, 125, 125), BorderSizePixel = 0, Text = "",
				}, gutter)
				codeRows[i], numRows[i] = cr, nr
			end
			cr.Size = UDim2.fromOffset(V.canvasW, LH)
			cr.Position = UDim2.fromOffset(6, (ln - 1) * LH)
			cr.Text = V.hl[ln] or esc(V.lines[ln])
			paintHits(i, ln, cr)
			cr.Visible = true
			nr.Size = UDim2.new(1, -6, 0, LH)
			nr.Position = UDim2.fromOffset(0, (ln - 1) * LH - cy)
			nr.Text = tostring(ln)
			nr.Visible = true
		else
			if cr then cr.Visible = false end
			if nr then nr.Visible = false end
		end
	end
end
connect(codeScroll:GetPropertyChangedSignal("CanvasPosition"), renderCode)
connect(codeScroll:GetPropertyChangedSignal("AbsoluteSize"), renderCode)

gotoLine = function(n)
	n = math.clamp(math.floor(n), 1, math.max(V.n, 1))
	local viewH = codeScroll.AbsoluteSize.Y
	codeScroll.CanvasPosition = Vector2.new(0, math.max(0, (n - 1) * LH - viewH / 2 + LH))
	renderCode()
end
gotoHit = function(k)
	if #F.hits == 0 then return end
	k = ((k - 1) % #F.hits) + 1
	F.cur = k
	local h = F.hits[k]
	local viewH, viewW = codeScroll.AbsoluteSize.Y, codeScroll.AbsoluteSize.X
	local x = ((h.col + h.len) * CW > viewW - 40) and math.max(0, (h.col - 1) * CW - 80) or 0
	codeScroll.CanvasPosition = Vector2.new(x, math.max(0, (h.ln - 1) * LH - viewH / 2 + LH))
	findCount.Text = k .. "/" .. #F.hits
	renderCode()
end
runFind = function()
	F.hits, F.byLine, F.cur = {}, {}, 0
	local q = findBox.Text
	F.lastQ = q
	if q == "" or V.n == 0 then
		findCount.Text = ""
		renderCode()
		return
	end
	local needle = q
	if F.pat then
		if not F.case then needle = X.ciPattern(q) end
	elseif not F.case then
		needle = q:lower()
	end
	local bad = false
	for ln = 1, V.n do
		local line = V.lines[ln]
		local subj = (not F.pat and not F.case) and line:lower() or line
		local init = 1
		while init <= #subj + 1 do
			local s, e
			if F.pat then
				local ok, a, b = pcall(string.find, subj, needle, init)
				if not ok then bad = true break end
				s, e = a, b
			else
				s, e = subj:find(needle, init, true)
			end
			if not s then break end
			local h = { ln = ln, col = s, len = math.max(e - s + 1, 1) }
			F.hits[#F.hits + 1] = h
			local bl = F.byLine[ln]
			if not bl then bl = {} F.byLine[ln] = bl end
			bl[#bl + 1] = h
			init = math.max(e + 1, s + 1)
			if #F.hits >= 5000 then break end
		end
		if bad or #F.hits >= 5000 then break end
	end
	if bad then
		findCount.Text = "patrón ✖"
		renderCode()
		return
	end
	findCount.Text = #F.hits == 0 and "0" or ("1/" .. #F.hits)
	if #F.hits > 0 then gotoHit(1) else renderCode() end
end

local function setCode(src, info)
	lastSource = src
	src = src:gsub("\r\n", "\n")
	src = src:gsub("\r", "\n")
	local lines, maxLen = {}, 0
	for raw in (src .. "\n"):gmatch("(.-)\n") do
		local line = raw:gsub("\t", "    ")
		line = line:gsub("[\0-\8\11-\31]", "")
		if not utf8.len(line) then line = line:gsub("[\128-\255]", "?") end
		if #line > MAXCOL then line = line:sub(1, MAXCOL) .. " …" end
		lines[#lines + 1] = line
		if #line > maxLen then maxLen = #line end
	end
	local my = { lines = lines, hl = {}, n = #lines }
	V = my
	local gw = math.max(34, #tostring(my.n) * CW + 14)
	gutter.Size = UDim2.new(0, gw, 1, -56 - 20)
	codeScroll.Position = UDim2.fromOffset(4 + gw, 56)
	codeScroll.Size = UDim2.new(1, -(8 + gw), 1, -56 - 20)
	my.canvasW = math.max(codeScroll.AbsoluteSize.X, maxLen * CW + 30)
	codeScroll.CanvasSize = UDim2.fromOffset(my.canvasW, my.n * LH + 10)
	codeScroll.CanvasPosition = Vector2.zero
	sInfo.Text = (info or "") .. (info and info ~= "" and " · " or "") .. my.n .. " líneas"
	F.hits, F.byLine, F.cur = {}, {}, 0
	renderCode()
	if findBox.Text ~= "" then task.defer(runFind) end
	-- resaltado en segundo plano (por tandas para no congelar el juego)
	task.spawn(function()
		local st = {}
		local limit = math.min(my.n, 30000)
		for i = 1, limit do
			if V ~= my or not alive then return end
			local ok, r = pcall(hlLine, lines[i], st)
			my.hl[i] = ok and r or nil
			if i % 300 == 0 then
				task.wait()
				if V == my then renderCode() end
			end
		end
		if V == my then renderCode() end
	end)
end

-- obtención del código ------------------------------------------------------------
local function withTimeout(fn, sec)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(fn)
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < sec do task.wait() end
	if not done then return false, "tiempo agotado (" .. sec .. "s)" end
	return ok, res
end
X.withTimeout = withTimeout

local function looksFailed(s)
	if s:match("^%s*$") then return true end
	if #s < 600 then
		local h = s:lower()
		if h:find("failed to decompile", 1, true) or h:find("decompilation failed", 1, true)
			or h:find("unable to decompile", 1, true) or h:find("cannot decompile", 1, true) then
			return true
		end
		-- algunos decompiladores devuelven un "return nil" vacío cuando no pueden leer el bytecode
		if h:match("^%s*return%s+nil%s*$") or h:match("^%s*%-%-[^\n]*\n%s*return%s+nil%s*$") then return true end
	end
	return false
end

-- último recurso: informe del bytecode (constantes, upvalues, funciones internas) sin decompilador
local function dumpClosure(inst, forced)
	local getc = getscriptclosure or getscriptfunction
	if not getc or not (debug and (debug.getconstants or debug.getupvalues)) then return nil end
	local ok, f = pcall(getc, inst)
	if not ok or type(f) ~= "function" then return nil end
	local head = forced and ("-- Informe del bytecode de " .. inst:GetFullName() .. "\n")
		or "-- No se pudo decompilar. Informe del bytecode (constantes, upvalues y funciones internas):\n"
	local body = X.describe(f, "principal", 0)
	return body ~= "" and (head .. body) or nil
end

local function fetchSource(inst, force)
	local c = X.srcCache[inst]
	if c and not force then return c.src, c.method, c.log end
	local log = {}
	local function attempt(name, fn, sec)
		local ok, r = withTimeout(fn, sec or 12)
		if ok and type(r) == "string" and not looksFailed(r) then return r end
		local why
		if not ok then why = tostring(r)
		elseif type(r) ~= "string" then why = "devolvió " .. type(r)
		elseif r:match("^%s*$") then why = "vacío"
		else why = "falló: " .. (r:sub(1, 80):gsub("%s+", " ")) end
		log[#log + 1] = name .. " → " .. why
	end
	local function done(src, method)
		X.srcCache[inst] = { src = src, method = method, log = log }
		return src, method, log
	end
	local src
	if type(decompile) == "function" then
		src = attempt("decompile()", function() return decompile(inst) end)
		if src then return done(src, "decompile()") end
	else
		log[#log + 1] = "decompile() → no existe en tu executor"
	end
	src = attempt(".Source", function() return inst.Source end, 4)
	if src then return done(src, ".Source") end
	if type(getscriptbytecode) == "function" and type(decompile) == "function" then
		src = attempt("decompile(bytecode)", function() return decompile(getscriptbytecode(inst)) end)
		if src then return done(src, "decompile(bytecode)") end
	end
	if type(getscriptclosure) == "function" and type(decompile) == "function" then
		src = attempt("decompile(closure)", function() return decompile(getscriptclosure(inst)) end)
		if src then return done(src, "decompile(closure)") end
	end
	local okd, dump = pcall(dumpClosure, inst)
	if okd and dump then return done(dump, "constantes (sin decompilador)") end
	return nil, nil, log
end
