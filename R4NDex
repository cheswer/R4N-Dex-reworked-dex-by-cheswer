local function makeDraggable(handle, onStart, onDelta)
	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			local start = input.Position
			local state = onStart()
			local con
			con = UIS.InputChanged:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
					onDelta(state, i.Position.X - start.X, i.Position.Y - start.Y)
				end
			end)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then con:Disconnect() end
			end)
		end
	end)
end

