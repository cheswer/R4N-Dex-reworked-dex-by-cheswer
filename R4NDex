local function refreshEntry(e)
	local ok, v = pcall(e.get)
	if not ok then return end
	local box = e.box
	if e.kind == "boolean" then
		box.Text = tostring(v)
		box.TextColor3 = v and C.good or C.bad
	elseif e.kind == "Instance" then
		box.Text = typeof(v) == "Instance" and v:GetFullName() or "nil"
	else
		if box:IsA("TextBox") and box:IsFocused() then return end
		box.Text = fmt(v)
	end
	if e.swatch then
		local col = typeof(v) == "BrickColor" and v.Color or v
		if typeof(col) == "Color3" then e.swatch.BackgroundColor3 = col end
	end
end

local function addProp(name, get, set, readonly)
	local ok, v = pcall(get)
	if not ok then return false end
	local kind = typeof(v)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, propScroll)
	text(row, " " .. name, { Size = UDim2.new(0.38, 0, 1, 0), TextColor3 = C.dim, TextTruncate = Enum.TextTruncate.AtEnd })
	local e = { get = get, kind = kind }
	local hasSwatch = (kind == "Color3" or kind == "BrickColor")
	local boxW = hasSwatch and UDim2.new(0.62, -22, 1, -2) or UDim2.new(0.62, 0, 1, -2)
	local base = { Position = UDim2.new(0.38, 0, 0, 1), Size = boxW, BackgroundColor3 = C.panel2, TextColor3 = C.text, Font = FONT, TextSize = 11, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }
	local box
	if kind == "boolean" and not readonly then
		base.AutoButtonColor = false
		box = new("TextButton", base, row)
		box.Activated:Connect(function()
			local ok2, cur = pcall(get)
			if ok2 then set(not cur) refreshEntry(e) end
		end)
	elseif kind == "Instance" then
		base.AutoButtonColor = false
		base.TextColor3 = C.accent2
		box = new("TextButton", base, row)
		box.Activated:Connect(function()
			local ok2, cur = pcall(get)
			if ok2 and typeof(cur) == "Instance" then selectInst(cur) reveal(cur) end
		end)
	else
		base.ClearTextOnFocus = false
		base.TextEditable = not (readonly or kind == "nil")
		box = new("TextBox", base, row)
		box.FocusLost:Connect(function(enter)
			if not enter or box.TextEditable == false then refreshEntry(e) return end
			local ok2, cur = pcall(get)
			local nv = ok2 and parseFor(cur, box.Text) or nil
			if nv == nil then notify("Valor inválido para " .. name .. " (" .. kind .. ")", "bad") else set(nv) end
			refreshEntry(e)
		end)
	end
	corner(box, 4)
	padding(box, 6, 0, 4, 0)
	e.box = box
	if hasSwatch then
		e.swatch = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, -18, 0.5, -8), BackgroundColor3 = Color3.new(), BorderSizePixel = 0 }, row)
		corner(e.swatch, 4)
		stroke(e.swatch)
	end
	entries[#entries + 1] = e
	refreshEntry(e)
	return true
end

buildProps = function(inst)
	clearProps()
	if not inst then propHeader.Text = "Nada seleccionado" return end
	propHeader.Text = " " .. inst.ClassName .. "  ·  " .. inst.Name
	local seen = {}
	section("Propiedades")
	for _, def in ipairs(PROPS) do
		if inst:IsA(def[1]) then
			for _, pn in ipairs(def[2]) do
				if not seen[pn] then
					seen[pn] = true
					addProp(pn, function() return getProp(inst, pn) end, function(v) setProp(inst, pn, v) end, READONLY[pn])
				end
			end
		end
	end
	local ok, at = pcall(function() return inst:GetAttributes() end)
	if ok and next(at) then
		section("Atributos")
		for k in pairs(at) do
			addProp(k, function() return inst:GetAttribute(k) end, function(nv) inst:SetAttribute(k, nv) notify("Atributo " .. k .. " actualizado", "good") end)
		end
	end
	local ok2, tg = pcall(function() return CollectionService:GetTags(inst) end)
	if ok2 and #tg > 0 then
		section("Tags")
		text(propScroll, "  " .. table.concat(tg, ", "), { Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.warn, LayoutOrder = nextOrder(), TextTruncate = Enum.TextTruncate.AtEnd })
	end
end

