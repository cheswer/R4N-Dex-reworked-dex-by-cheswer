-- formateo / serialización ---------------------------------------------------
local function r3(n) return math.floor(n * 1000 + 0.5) / 1000 end
local function fmt(v)
	local t = typeof(v)
	if t == "Color3" then
		return ("%d, %d, %d"):format(math.floor(v.R * 255 + .5), math.floor(v.G * 255 + .5), math.floor(v.B * 255 + .5))
	elseif t == "Vector3" then return ("%s, %s, %s"):format(r3(v.X), r3(v.Y), r3(v.Z))
	elseif t == "Vector2" then return ("%s, %s"):format(r3(v.X), r3(v.Y))
	elseif t == "UDim2" then return ("%s, %s, %s, %s"):format(r3(v.X.Scale), v.X.Offset, r3(v.Y.Scale), v.Y.Offset)
	elseif t == "UDim" then return ("%s, %s"):format(r3(v.Scale), v.Offset)
	elseif t == "CFrame" then
		local c = { v:GetComponents() }
		for i = 1, #c do c[i] = r3(c[i]) end
		return table.concat(c, ", ")
	elseif t == "EnumItem" or t == "BrickColor" then return v.Name
	elseif t == "Instance" then return v:GetFullName()
	elseif t == "string" then return v
	end
	return tostring(v)
end

local function nums(s)
	local out = {}
	for m in s:gmatch("[%-%+%d%.eE]+") do
		local n = tonumber(m)
		if n then out[#out + 1] = n end
	end
	return out
end
local function parseFor(old, s)
	local t = typeof(old)
	if t == "string" then return s
	elseif t == "number" then return tonumber(s)
	elseif t == "Color3" then
		if s:match("^#?%x%x%x%x%x%x$") then return Color3.fromHex(s) end
		local n = nums(s)
		if #n == 3 then return Color3.fromRGB(n[1], n[2], n[3]) end
	elseif t == "Vector3" then local n = nums(s); if #n == 3 then return Vector3.new(n[1], n[2], n[3]) end
	elseif t == "Vector2" then local n = nums(s); if #n == 2 then return Vector2.new(n[1], n[2]) end
	elseif t == "UDim2" then local n = nums(s); if #n == 4 then return UDim2.new(n[1], n[2], n[3], n[4]) end
	elseif t == "UDim" then local n = nums(s); if #n == 2 then return UDim.new(n[1], n[2]) end
	elseif t == "CFrame" then
		local n = nums(s)
		if #n == 3 or #n == 12 then return CFrame.new(table.unpack(n)) end
	elseif t == "EnumItem" then
		for _, it in ipairs(old.EnumType:GetEnumItems()) do
			if it.Name:lower() == s:lower() then return it end
		end
	elseif t == "BrickColor" then
		local ok, bc = pcall(BrickColor.new, s)
		if ok then return bc end
	end
	return nil
end

local function idx(n)
	if n:match("^[%a_][%w_]*$") then return "." .. n end
	return '["' .. n:gsub("\\", "\\\\"):gsub('"', '\\"') .. '"]'
end
local function getPath(i)
	local chain, c = {}, i
	while c and c ~= game do
		table.insert(chain, 1, c)
		c = c.Parent
	end
	if c ~= game then return "--[[sin padre]] " .. i:GetFullName() end
	local s = "game"
	for k, inst in ipairs(chain) do
		if k == 1 then s = s .. ':GetService("' .. inst.ClassName .. '")' else s = s .. idx(inst.Name) end
	end
	return s
end

-- serializador / dumper v2 (antes: funciones y userdata salían como "nil --[[function]]") ------------------
local ser
do
	local LUAKW = {}
	for w in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%a+") do LUAKW[w] = true end
	local ESCMAP = { ["\\"] = "\\\\", ['"'] = '\\"', ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t" }
	local function qstr(s)
		local r = s:gsub('[%c\\"]', function(c) return ESCMAP[c] or ("\\%03d"):format(c:byte()) end)
		if not utf8.len(r) then
			r = r:gsub("[\128-\255]", function(c) return ("\\%03d"):format(c:byte()) end)
		end
		return '"' .. r .. '"'
	end
	local function qnum(n)
		if n ~= n then return "(0/0)" end
		if n == math.huge then return "math.huge" end
		if n == -math.huge then return "-math.huge" end
		if n == math.floor(n) and math.abs(n) < 1e15 then return ("%d"):format(n) end
		return (("%.10g"):format(n))
	end
	local function cm(s) return "--[=[ " .. (tostring(s):gsub("%]=%]", "] =]")) .. " ]=]" end
	local function isIdent(k) return type(k) == "string" and k:match("^[%a_][%w_]*$") ~= nil and not LUAKW[k] end
	local RANK = { number = 1, string = 2, boolean = 3 }
	local function keyOrder(a, b)
		local ta, tb = type(a), type(b)
		if ta == "number" and tb == "number" then return a < b end
		local ra, rb = RANK[ta] or 9, RANK[tb] or 9
		if ra ~= rb then return ra < rb end
		return tostring(a) < tostring(b)
	end

	local function fnInfo(f)
		local info = { name = "", src = "", line = -1, params = -1, vararg = false, kind = "Lua" }
		pcall(function()
			if debug.info then
				local s, l, n, a, v = debug.info(f, "slna")
				info.src, info.line, info.name = s or "", l or -1, n or ""
				info.params, info.vararg = a or -1, v and true or false
			end
		end)
		if (info.src == "" or info.line == -1) and debug.getinfo then
			pcall(function()
				local t = debug.getinfo(f)
				info.src = t.source or t.short_src or info.src
				info.line = t.linedefined or t.currentline or info.line
				if t.name and t.name ~= "" then info.name = t.name end
				info.params = t.numparams or t.nparams or info.params
				if t.is_vararg == 1 or t.is_vararg == true then info.vararg = true end
			end)
		end
		pcall(function()
			if iscclosure and iscclosure(f) then info.kind = "C"
			elseif isexecutorclosure and isexecutorclosure(f) then info.kind = "executor" end
		end)
		if type(info.line) ~= "number" then info.line = -1 end
		if type(info.params) ~= "number" then info.params = -1 end
		return info
	end

	local function constList(f, maxN)
		local out = {}
		if not (debug and debug.getconstants) then return out end
		local ok, cs = pcall(debug.getconstants, f)
		if not ok or type(cs) ~= "table" then return out end
		local keys = {}
		for k in pairs(cs) do if type(k) == "number" then keys[#keys + 1] = k end end
		table.sort(keys)
		for _, k in ipairs(keys) do
			local v, tv = cs[k], type(cs[k])
			if tv == "string" then
				out[#out + 1] = qstr(#v > 60 and (v:sub(1, 60) .. "…") or v)
			elseif tv == "number" then
				out[#out + 1] = qnum(v)
			end
			if maxN and #out >= maxN then break end
		end
		return out
	end

	local function instRef(v)
		local okd, desc = pcall(function() return v:IsDescendantOf(game) end)
		if okd and desc then return getPath(v) end
		if v == game then return "game" end
		local okn, nm = pcall(function() return v.ClassName .. " " .. qstr(v.Name) end)
		return "nil --[[Instance sin padre: " .. ((okn and nm or "?"):gsub("%]%]", "] ]")) .. "]]"
	end

	local go
	local function fnText(f, o)
		local i = fnInfo(f)
		local ps = {}
		for n = 1, math.max(0, i.params) do ps[n] = "p" .. n end
		if i.vararg then ps[#ps + 1] = "..." end
		local meta = { i.kind .. " function" }
		if i.name ~= "" then meta[#meta + 1] = "name: " .. i.name end
		if i.line >= 0 then meta[#meta + 1] = "line " .. i.line end
		if i.src ~= "" then meta[#meta + 1] = (i.src:gsub("^@", "")) end
		if o.fnDetail then
			local cs = constList(f, 8)
			if #cs > 0 then meta[#meta + 1] = "consts: " .. table.concat(cs, ", ") end
			if debug.getupvalues then
				local ok, ups = pcall(debug.getupvalues, f)
				if ok and type(ups) == "table" then
					local n = 0
					for _ in pairs(ups) do n += 1 end
					if n > 0 then meta[#meta + 1] = n .. " upvalues" end
				end
			end
		end
		return ("function(%s) end %s"):format(table.concat(ps, ", "), cm(table.concat(meta, " · ")))
	end

	local function tableText(v, depth, o, stack, path)
		local ind, ind0 = string.rep("\t", depth + 1), string.rep("\t", depth)
		local out, count, mark, len = {}, 0, {}, 0
		pcall(function() len = #v end)
		for i = 1, len do
			if count >= o.maxEntries then break end
			local val = rawget(v, i)
			if val == nil then break end
			mark[i] = true
			count += 1
			out[#out + 1] = ind .. go(val, depth + 1, o, stack, path .. "[" .. i .. "]")
		end
		local keys = {}
		for k in next, v do
			if not mark[k] then keys[#keys + 1] = k end
		end
		table.sort(keys, keyOrder)
		for _, k in ipairs(keys) do
			if count >= o.maxEntries then
				out[#out + 1] = ind .. "-- ... (más entradas recortadas)"
				break
			end
			count += 1
			local ks, kpath
			if isIdent(k) then
				ks, kpath = k, path .. "." .. k
			else
				ks = "[" .. go(k, depth + 1, o, stack, path .. ".<clave>") .. "]"
				kpath = path .. "[" .. (type(k) == "string" and qstr(k) or tostring(k)) .. "]"
			end
			out[#out + 1] = ind .. ks .. " = " .. go(rawget(v, k), depth + 1, o, stack, kpath)
		end
		if #out == 0 then return "{}" end
		return "{\n" .. table.concat(out, ",\n") .. "\n" .. ind0 .. "}"
	end

	go = function(v, depth, o, stack, path)
		o.nodes += 1
		if o.nodes > o.maxNodes then return "nil --[[recortado: demasiados nodos]]" end
		local t = typeof(v)
		if t == "string" then
			if #v > o.maxStr then return qstr(v:sub(1, o.maxStr)) .. " --[[+" .. (#v - o.maxStr) .. " bytes]]" end
			return qstr(v)
		elseif t == "number" then return qnum(v)
		elseif t == "boolean" or t == "nil" then return tostring(v)
		elseif t == "table" then
			if stack[v] then return "nil --[[ciclo → " .. stack[v] .. "]]" end
			if depth >= o.maxDepth then
				local n = 0
				pcall(function() for _ in next, v do n += 1 if n >= 999 then break end end end)
				return "{} --[[... " .. n .. " entradas (profundidad máx.)]]"
			end
			stack[v] = (path == "" and "<raíz>" or path)
			local okb, body = pcall(tableText, v, depth, o, stack, path)
			stack[v] = nil
			if not okb then return "nil --[[error leyendo tabla: " .. tostring(body):sub(1, 80) .. "]]" end
			if o.metatables then
				local mt
				pcall(function() mt = (getrawmetatable or getmetatable)(v) end)
				if type(mt) == "table" then
					body = "setmetatable(" .. body .. ", " .. go(mt, depth + 1, o, stack, path .. ".<mt>") .. ")"
				end
			end
			return body
		elseif t == "function" then return fnText(v, o)
		elseif t == "Instance" then return instRef(v)
		elseif t == "Vector3" then return ("Vector3.new(%s, %s, %s)"):format(qnum(v.X), qnum(v.Y), qnum(v.Z))
		elseif t == "Vector2" then return ("Vector2.new(%s, %s)"):format(qnum(v.X), qnum(v.Y))
		elseif t == "Vector3int16" then return ("Vector3int16.new(%d, %d, %d)"):format(v.X, v.Y, v.Z)
		elseif t == "Vector2int16" then return ("Vector2int16.new(%d, %d)"):format(v.X, v.Y)
		elseif t == "CFrame" then
			local c = { v:GetComponents() }
			for i = 1, #c do c[i] = qnum(c[i]) end
			return "CFrame.new(" .. table.concat(c, ", ") .. ")"
		elseif t == "Color3" then
			return ("Color3.fromRGB(%d, %d, %d)"):format(math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5))
		elseif t == "UDim" then return ("UDim.new(%s, %s)"):format(qnum(v.Scale), qnum(v.Offset))
		elseif t == "UDim2" then return ("UDim2.new(%s, %s, %s, %s)"):format(qnum(v.X.Scale), qnum(v.X.Offset), qnum(v.Y.Scale), qnum(v.Y.Offset))
		elseif t == "Rect" then return ("Rect.new(%s, %s, %s, %s)"):format(qnum(v.Min.X), qnum(v.Min.Y), qnum(v.Max.X), qnum(v.Max.Y))
		elseif t == "NumberRange" then return ("NumberRange.new(%s, %s)"):format(qnum(v.Min), qnum(v.Max))
		elseif t == "NumberSequence" then
			local k = {}
			for _, p in ipairs(v.Keypoints) do k[#k + 1] = ("NumberSequenceKeypoint.new(%s, %s, %s)"):format(qnum(p.Time), qnum(p.Value), qnum(p.Envelope)) end
			return "NumberSequence.new({" .. table.concat(k, ", ") .. "})"
		elseif t == "ColorSequence" then
			local k = {}
			for _, p in ipairs(v.Keypoints) do k[#k + 1] = ("ColorSequenceKeypoint.new(%s, %s)"):format(qnum(p.Time), go(p.Value, depth, o, stack, path)) end
			return "ColorSequence.new({" .. table.concat(k, ", ") .. "})"
		elseif t == "BrickColor" then return ("BrickColor.new(%s)"):format(qstr(v.Name))
		elseif t == "EnumItem" then return tostring(v)
		elseif t == "Enum" then return "Enum." .. tostring(v)
		elseif t == "Enums" then return "Enum"
		elseif t == "TweenInfo" then
			return ("TweenInfo.new(%s, %s, %s, %s, %s, %s)"):format(qnum(v.Time), tostring(v.EasingStyle), tostring(v.EasingDirection), qnum(v.RepeatCount), tostring(v.Reverses), qnum(v.DelayTime))
		elseif t == "Ray" then return ("Ray.new(%s, %s)"):format(go(v.Origin, depth, o, stack, path), go(v.Direction, depth, o, stack, path))
		elseif t == "PhysicalProperties" then
			return ("PhysicalProperties.new(%s, %s, %s, %s, %s)"):format(qnum(v.Density), qnum(v.Friction), qnum(v.Elasticity), qnum(v.FrictionWeight), qnum(v.ElasticityWeight))
		elseif t == "Font" then return ("Font.new(%s)"):format(qstr(tostring(v.Family)))
		elseif t == "DateTime" then return ("DateTime.fromUnixTimestampMillis(%s)"):format(qnum(v.UnixTimestampMillis))
		elseif t == "buffer" then
			local okb, n = pcall(buffer.len, v)
			if okb and n <= 512 then
				local oks, s = pcall(buffer.readstring, v, 0, n)
				if oks then return "buffer.fromstring(" .. qstr(s) .. ")" end
			end
			return "nil --[[buffer de " .. tostring(okb and n or "?") .. " bytes]]"
		elseif t == "RBXScriptSignal" or t == "RBXScriptConnection" then return "nil --[[" .. t .. "]]"
		elseif t == "thread" then return "nil --[[thread]]"
		end
		local okt, s = pcall(tostring, v)
		return "nil --[[" .. t .. ": " .. ((okt and s or "?"):gsub("%]%]", "] ]")) .. "]]"
	end

	ser = function(v, depth, seen, opts)
		if type(depth) == "table" then opts = depth end
		local o = { maxDepth = 6, maxEntries = 300, maxNodes = 15000, maxStr = 3000, nodes = 0, fnDetail = false, metatables = true }
		for k, val in pairs(opts or {}) do o[k] = val end
		local ok, res = pcall(go, v, 0, o, {}, "")
		return ok and res or ("nil --[[error al serializar: " .. tostring(res) .. "]]")
	end

	-- informe de un closure: info, upvalues (con valores), constantes y funciones internas
	local function describe(f, label, depth, state)
		state = state or { n = 0 }
		depth = depth or 0
		state.n += 1
		if state.n > 400 then return "" end
		local ind = string.rep("  ", depth)
		local i = fnInfo(f)
		local out = {}
		out[#out + 1] = ("%s-- %s%s · %s · línea %s · %d param%s"):format(
			ind, label or "función", i.name ~= "" and (" «" .. i.name .. "»") or "", i.kind, tostring(i.line),
			math.max(i.params, 0), i.vararg and " (+...)" or "")
		if debug.getupvalues then
			local ok, ups = pcall(debug.getupvalues, f)
			if ok and type(ups) == "table" then
				local ks = {}
				for k in pairs(ups) do ks[#ks + 1] = k end
				table.sort(ks, keyOrder)
				for n, k in ipairs(ks) do
					if n > 40 then out[#out + 1] = ind .. "--   (más upvalues…)" break end
					local sv = ser(ups[k], { maxDepth = 2, maxEntries = 20, maxNodes = 300 }):gsub("%s*\n%s*", " ")
					out[#out + 1] = ind .. "--   upvalue[" .. tostring(k) .. "] = " .. sv
				end
			end
		end
		local cs = constList(f, 150)
		if #cs > 0 then
			local line = ind .. "--   constantes: "
			for _, c in ipairs(cs) do
				if #line + #c > 150 then
					out[#out + 1] = line
					line = ind .. "--     "
				end
				line = line .. c .. ", "
			end
			out[#out + 1] = line
		end
		if depth < 4 and debug.getprotos then
			local okp, ps = pcall(debug.getprotos, f)
			if okp and type(ps) == "table" then
				for idx, p in ipairs(ps) do
					if type(p) == "function" then
						local sub = describe(p, "función interna #" .. idx, depth + 1, state)
						if sub ~= "" then out[#out + 1] = sub end
					end
				end
			end
		end
		return table.concat(out, "\n")
	end

	X.qstr, X.qnum, X.fnInfo, X.constList, X.describe, X.keyOrder = qstr, qnum, fnInfo, constList, describe, keyOrder
	X.ciPattern = function(p)
		local out, i, n = {}, 1, #p
		while i <= n do
			local c = p:sub(i, i)
			if c == "%" then
				out[#out + 1] = p:sub(i, i + 1)
				i += 2
			elseif c == "[" then
				local j = i + 1
				if p:sub(j, j) == "^" then j += 1 end
				if p:sub(j, j) == "]" then j += 1 end
				while j <= n and p:sub(j, j) ~= "]" do
					if p:sub(j, j) == "%" then j += 1 end
					j += 1
				end
				out[#out + 1] = p:sub(i, j)
				i = j + 1
			elseif c:match("%a") then
				out[#out + 1] = "[" .. c:lower() .. c:upper() .. "]"
				i += 1
			else
				out[#out + 1] = c
				i += 1
			end
		end
		return table.concat(out)
	end
end

