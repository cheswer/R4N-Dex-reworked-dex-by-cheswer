		else
			notify("require falló: " .. tostring(res), "bad")
		end
	end)
end, { TextSize = 13 })
button(sBar, "Copiar", function()
	if lastSource == "" then notify("No hay código que copiar", "warn") return end
	copyN(lastSource, "Código copiado")
