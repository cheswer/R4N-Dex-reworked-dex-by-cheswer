local X = {
	cfg = { blacklist = true },
	favs = {},
	srcCache = setmetatable({}, { __mode = "k" }),
	constCache = setmetatable({}, { __mode = "k" }),
}
do
	local BL_ANCESTORS = {}
	for n in ([[PlayerModule PlayerScriptsLoader RbxCharacterSounds ChatScript ChatMain BubbleChat ChatServiceRunner
		ChatModules ClientChatModules ChatLocalization TopBarApp BackpackScript PlayerListScript EmotesMenu
		ControlScript CameraScript]]):gmatch("[%w_]+") do
		BL_ANCESTORS[n] = true
	end
	local BL_SERVICES = { CoreGui = true, CorePackages = true, Chat = true, RobloxPluginGuiService = true }
	local cache = setmetatable({}, { __mode = "k" })

	local function compute(inst)
		local p, d = inst, 0
		while p and p ~= game and d < 80 do
			if BL_ANCESTORS[p.Name] and p:IsA("LuaSourceContainer") then return true end
			local par = p.Parent
			if par == game and BL_SERVICES[p.ClassName] then return true end
			p, d = par, d + 1
		end
		if inst:IsA("LuaSourceContainer") and not inst:IsA("ModuleScript") then
			local n, par = inst.Name, inst.Parent
			if n == "Animate" and (inst:FindFirstChild("walk") or inst:FindFirstChild("run")) then return true end
			if par and (n == "Health" or n == "Sound") and par:FindFirstChildOfClass("Humanoid") then return true end
		end
		return false
	end

	X.isDefault = function(inst)
		local c = cache[inst]
		if c ~= nil then return c end
		local ok, res = pcall(compute, inst)
		res = ok and res or false
		if not res and type(env.R4N_Blacklist) == "table" then
			local okn, full = pcall(inst.GetFullName, inst)
			full = (okn and full or inst.Name):lower()
			for _, s in ipairs(env.R4N_Blacklist) do
				if type(s) == "string" and s ~= "" and full:find(s:lower(), 1, true) then res = true break end
			end
		end
		cache[inst] = res
		return res
	end
	X.clearBlCache = function() for k in pairs(cache) do cache[k] = nil end end
	X.skip = function(inst) return X.cfg.blacklist and X.isDefault(inst) end
	X.escRT = function(s) return (tostring(s):gsub("[&<>\"']", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" })) end
end

