local logs, logSel, logN, blocked = {}, nil, 0, {}
local function genCode(e)
	local parts = {}
	for i = 1, e.args.n do parts[i] = ser(e.args[i]) end
	local s = ("local args = {%s}\n%s:%s(unpack(args, 1, %d))"):format(table.concat(parts, ", "), getPath(e.remote), e.method, e.args.n)
	if #s > 12000 then s = s:sub(1, 12000) .. "\n-- ... (recortado)" end
	return s
end
local function addLog(remote, method, args)
	if not alive then return end
	logN += 1
	local e = { remote = remote, method = method, args = args }
	logs[#logs + 1] = e
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = C.panel, BackgroundTransparency = 0, BorderSizePixel = 0, AutoButtonColor = false,
		Font = MONO, TextSize = 13, TextColor3 = method == "FireServer" and C.text or C.warn, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = (" [%s] %s  %s  (%d)"):format(os.date("%H:%M:%S"), method == "FireServer" and "F" or "I", remote.Name, args.n),
		LayoutOrder = logN,
	}, rList)
	e.btn = b
	b.MouseEnter:Connect(function() if logSel ~= e then b.BackgroundColor3 = C.hover end end)
	b.MouseLeave:Connect(function() if logSel ~= e then b.BackgroundColor3 = C.panel end end)
	b.Activated:Connect(function()
		if logSel and logSel.btn then logSel.btn.BackgroundColor3 = C.panel end
		logSel = e
		b.BackgroundColor3 = C.sel
		rDetailText.TextColor3 = C.text
		rDetailText.Text = genCode(e)
	end)
	if #logs > 250 then
		local old = table.remove(logs, 1)
		if old.btn then old.btn:Destroy() end
	end
	rList.CanvasPosition = Vector2.new(0, 1e6)
end

