	[Enum.MessageType.MessageOutput] = C.text, [Enum.MessageType.MessageInfo] = C.accent2,
	[Enum.MessageType.MessageWarning] = C.warn, [Enum.MessageType.MessageError] = C.bad,
}
local conN, conLines = 0, {}
local function cLine(msg, mtype)
	conN += 1
	local l = text(conScroll, msg, {
		Font = MONO, TextSize = 11, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -6, 0, 0), TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = conColors[mtype] or C.text, LayoutOrder = conN,
	})
	conLines[#conLines + 1] = l
	if #conLines > 400 then table.remove(conLines, 1):Destroy() end
	conScroll.CanvasPosition = Vector2.new(0, 1e6)
end
pcall(function()
	local hist = LogService:GetLogHistory()
	for i = math.max(1, #hist - 80), #hist do cLine(hist[i].message, hist[i].messageType) end
end)
connect(LogService.MessageOut, cLine)
connect(conBox.FocusLost, function(enter)
	if not enter or conBox.Text == "" then return end
	local code = conBox.Text
	conBox.Text = ""
	cLine("> " .. code, Enum.MessageType.MessageInfo)
	local fn, err = loadstring(code)
	if not fn then cLine("✖ " .. tostring(err), Enum.MessageType.MessageError) return end
	task.spawn(function()
		local ok, e = pcall(fn)
		if not ok then cLine("✖ " .. tostring(e), Enum.MessageType.MessageError) end
	end)
end)

-- Herramientas -----------------------------------------------------------------
local toolTab = addTab("Tools")
local toolScroll = vscroll(toolTab, { Size = UDim2.new(1, 0, 1, 0) })
padding(toolScroll, 4)
local function tool(label, fn)
	local b = button(toolScroll, label, fn, { Size = UDim2.new(1, 0, 0, 26), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = Enum.TextXAlignment.Left })
	b.LayoutOrder = nextOrder()
end
local function treeText(inst, maxDepth, maxLines)
	local out = {}
	local function walk(i, d)
		if #out >= maxLines then return end
		out[#out + 1] = string.rep("  ", d) .. i.Name .. " [" .. i.ClassName .. "]"
		if d < maxDepth then for _, c in ipairs(kids(i)) do walk(c, d + 1) end end
	end
	walk(inst, 0)
	return table.concat(out, "\n")
end
tool("📋 Copiar árbol del seleccionado", function()
	if need() then notify(copy(treeText(selected, 6, 3000)) and "Árbol copiado" or "Sin setclipboard", "good") end
end)
tool("💾 Guardar árbol en archivo", function()
	if not need() then return end
	if not writefile then notify("Sin writefile", "bad") return end
	if makefolder and isfolder and not isfolder("R4NDex") then makefolder("R4NDex") end
	local p = "R4NDex/tree_" .. selected.Name:gsub("[^%w_%-]", "_") .. ".txt"
	local ok = pcall(writefile, p, treeText(selected, 12, 20000))
	notify(ok and ("Guardado: " .. p) or "Error al guardar", ok and "good" or "bad")
end)
tool("⚡ Activar todos los ProximityPrompt (hijos)", function()
	if not need() then return end
	if not fireproximityprompt then notify("Sin fireproximityprompt", "bad") return end
	local n = 0
	for _, d in ipairs(selected:GetDescendants()) do
		if d:IsA("ProximityPrompt") then pcall(fireproximityprompt, d) n += 1 end
	end
	notify(n .. " prompts activados", "good")
end)
tool("🖱 Activar todos los ClickDetector (hijos)", function()
	if not need() then return end
	if not fireclickdetector then notify("Sin fireclickdetector", "bad") return end
	local n = 0
	for _, d in ipairs(selected:GetDescendants()) do
		if d:IsA("ClickDetector") then pcall(fireclickdetector, d) n += 1 end
	end
	notify(n .. " detectores activados", "good")
end)
tool("✨ Activar/desactivar resaltado de selección", function()
	hlOn = not hlOn
	updateHighlight()
	notify("Resaltado " .. (hlOn and "ON" or "OFF"))
end)
tool("📦 Guardar juego (saveinstance)", function()
	if not saveinstance then notify("Sin saveinstance", "bad") return end
	task.spawn(function()
		notify("Guardando juego…", "warn")
		local ok, err = pcall(saveinstance)
		notify(ok and "saveinstance terminado" or ("Error: " .. tostring(err)), ok and "good" or "bad")
	end)
end)
tool("🔎 Ver compatibilidad del executor", function()
	local caps = {
		decompile = decompile, hookmetamethod = hookmetamethod, getnilinstances = getnilinstances, getscripts = getscripts,
		getloadedmodules = getloadedmodules, setclipboard = setclipboard or toclipboard, writefile = writefile,
		fireproximityprompt = fireproximityprompt, fireclickdetector = fireclickdetector, saveinstance = saveinstance,
		gethiddenproperty = gethiddenproperty, sethiddenproperty = sethiddenproperty, cloneref = cloneref, gethui = gethui,
	}
	local out = {}
	for k, v in pairs(caps) do out[#out + 1] = (v and "✔ " or "✖ ") .. k end
	table.sort(out)
	cLine("— Compatibilidad —\n" .. table.concat(out, "\n"), Enum.MessageType.MessageInfo)
	showTab("Consola")
end)

